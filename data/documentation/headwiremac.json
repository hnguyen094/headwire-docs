{"metadata":{"symbolKind":"module","title":"HeadwireMac","role":"collection","roleHeading":"Command-line Tool","externalID":"HeadwireMac","modules":[{"name":"HeadwireMac"}]},"kind":"symbol","identifier":{"url":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"HeadwireMac is the helper’s AppKit and SwiftUI shell. It reads the world (the online displays from CoreGraphics, their EDIDs from the IORegistry, the permissions macOS has granted, the menu’s choices from the helper’s defaults), hands what it read to "},{"code":"HeadwireMacKit","type":"codeVoice"},{"type":"text","text":"‘s value types, and carries out what they decide: it sets the capture display’s mode and starts or stops the host in "},{"code":"HeadwireMacHost","type":"codeVoice"},{"type":"text","text":" as the menu’s switches change. It owns the menu, the pairing window with its code and QR, the question it puts before trusting a new device on the USB cable, the About window with every licence the helper ships, and the command-line flags. It makes no decision a person sees on its own and holds no streaming, input or pairing code. Headwire works without the helper: the capture card and Bluetooth HID need nothing on the Mac."}],"type":"paragraph"},{"inlineContent":[{"text":"The launch flags:","type":"text"}],"type":"paragraph"},{"type":"termList","items":[{"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets no display mode and posts no input; it logs what it would do instead."}]}]},"term":{"inlineContent":[{"code":"--dry-run","type":"codeVoice"}]}},{"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Streams a moving test pattern without Screen Recording, and keeps its key out of the keychain."}]}]},"term":{"inlineContent":[{"code":"--synthetic","type":"codeVoice"}]}},{"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Prints the displays, the capture display and the plan, then exits without setting or starting anything."}]}]},"term":{"inlineContent":[{"code":"--once","type":"codeVoice"}]}},{"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Never asks for Bluetooth."}]}]},"term":{"inlineContent":[{"code":"--no-bluetooth","type":"codeVoice"}]}},{"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Admits a device’s key fingerprint for this launch without pairing, for development."}]}]},"term":{"inlineContent":[{"code":"--trust <key>","type":"codeVoice"}]}}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"title":"Starting","anchor":"Starting","identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/Main","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HeadwireMacApp","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/OnceReport"]},{"title":"The display mode","anchor":"The-display-mode","identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HelperController","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HelperSettings","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/LiveDisplays","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/EDIDRegistry","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/DisplayChanges","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/ModeSetter","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/LiveModeSetter","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/DryRunModeSetter"]},{"title":"Streaming and input","anchor":"Streaming-and-input","identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HostController","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/PermissionCenter","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/CableQuestion"]},{"title":"The menu and windows","identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HelperMenu","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HostMenu","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/SidecarMenu","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/PairingView","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/AboutView"],"anchor":"The-menu-and-windows"},{"title":"Extended Modules","generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HeadwireMacKit","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HeadwireWire"]}],"sections":[],"hierarchy":{"paths":[[]]},"abstract":[{"text":"Headwire Helper, the optional menu-bar app on the Mac.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/headwiremac"]}],"references":{"doc://HeadwireMac/documentation/HeadwireMac/ModeSetter":{"title":"ModeSetter","abstract":[{"type":"text","text":"Puts a display into a mode, or in a dry run only says it would."}],"navigatorTitle":[{"kind":"identifier","text":"ModeSetter"}],"url":"\/documentation\/headwiremac\/modesetter","type":"topic","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/ModeSetter","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ModeSetter"}]},"doc://HeadwireMac/documentation/HeadwireMac/PermissionCenter":{"title":"PermissionCenter","kind":"symbol","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/PermissionCenter","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PermissionCenter","kind":"identifier"}],"url":"\/documentation\/headwiremac\/permissioncenter","abstract":[{"type":"text","text":"Reads and asks for the permissions the helper’s features need. Reading never prompts; asking"},{"type":"text","text":" "},{"type":"text","text":"shows macOS’s own prompt once, then opens the pane in System Settings."}],"navigatorTitle":[{"text":"PermissionCenter","kind":"identifier"}],"type":"topic"},"doc://HeadwireMac/documentation/HeadwireMac":{"abstract":[{"type":"text","text":"Headwire Helper, the optional menu-bar app on the Mac."}],"kind":"symbol","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac","url":"\/documentation\/headwiremac","title":"HeadwireMac","role":"collection","type":"topic"},"doc://HeadwireMac/documentation/HeadwireMac/DryRunModeSetter":{"identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/DryRunModeSetter","title":"DryRunModeSetter","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DryRunModeSetter"}],"url":"\/documentation\/headwiremac\/dryrunmodesetter","kind":"symbol","abstract":[{"type":"text","text":"Logs what it would do and touches nothing. The only setter a dry run is given."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DryRunModeSetter"}],"type":"topic"},"doc://HeadwireMac/documentation/HeadwireMac/HostMenu":{"abstract":[{"type":"text","text":"The menu’s Streaming and Input section: the toggles, what each needs, and the paired devices."}],"kind":"symbol","type":"topic","url":"\/documentation\/headwiremac\/hostmenu","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HostMenu","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HostMenu"}],"navigatorTitle":[{"kind":"identifier","text":"HostMenu"}],"role":"symbol","title":"HostMenu"},"doc://HeadwireMac/documentation/HeadwireMac/HelperController":{"type":"topic","title":"HelperController","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HelperController","url":"\/documentation\/headwiremac\/helpercontroller","abstract":[{"text":"Ties the displays, the iPad’s request, and the menu together, and applies the plan.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HelperController","kind":"identifier"}],"navigatorTitle":[{"text":"HelperController","kind":"id