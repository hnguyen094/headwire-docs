PermissionCenter","title":"PermissionCenter"},"doc://HeadwireMac/documentation/HeadwireMac/HeadwireWire":{"kind":"symbol","role":"collection","url":"\/documentation\/headwiremac\/headwirewire","type":"topic","title":"HeadwireWire","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HeadwireWire","abstract":[]},"doc://HeadwireMac/documentation/HeadwireMac/DryRunModeSetter":{"title":"DryRunModeSetter","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DryRunModeSetter"}],"abstract":[{"text":"Logs what it would do and touches nothing. The only setter a dry run is given.","type":"text"}],"url":"\/documentation\/headwiremac\/dryrunmodesetter","role":"symbol","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/DryRunModeSetter","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DryRunModeSetter"}]},"doc://HeadwireMac/documentation/HeadwireMac/OnceReport":{"title":"OnceReport","abstract":[{"code":"--once","type":"codeVoice"},{"type":"text","text":": prints every display, the capture display, and the plan, then exits. Sets nothing."}],"url":"\/documentation\/headwiremac\/oncereport","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"OnceReport"}],"navigatorTitle":[{"kind":"identifier","text":"OnceReport"}],"type":"topic","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/OnceReport","role":"symbol"},"doc://HeadwireMac/documentation/HeadwireMac/PairingView":{"title":"PairingView","abstract":[{"text":"The pairing window: the code to type on the device, and the QR to scan.","type":"text"}],"url":"\/documentation\/headwiremac\/pairingview","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PairingView"}],"navigatorTitle":[{"kind":"identifier","text":"PairingView"}],"type":"topic","identifier":"doc:\/\/HeadwireMac\/documentation\/Hea