":"OnceReport"}],"abstract":[{"type":"codeVoice","code":"--once"},{"type":"text","text":": prints every display, the capture display, and the plan, then exits. Sets nothing."}],"role":"symbol"},"doc://HeadwireMac/documentation/HeadwireMac/HelperSettings":{"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"HelperSettings"}],"title":"HelperSettings","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HelperSettings","abstract":[{"text":"The menu choices, kept in the helper’s defaults.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"HelperSettings"}],"url":"\/documentation\/headwiremac\/helpersettings"},"doc://HeadwireMac/documentation/HeadwireMac/HostMenu":{"role":"symbol","type":"topic","navigatorTitle":[{"text":"HostMenu","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The menu’s Streaming and Input section: the toggles, what each needs, and the paired devices."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HostMenu","kind":"identifier"}],"identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HostMenu","title":"HostMenu","url":"\/documentation\/headwiremac\/hostmenu"},"doc://HeadwireMac/documentation/HeadwireMac/ModeSetter":{"url":"\/documentation\/headwiremac\/modesetter","type":"topic","title":"ModeSetter","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/ModeSetter","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ModeSetter","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"ModeSetter"}],"abstract":[{"type":"text","text":"Puts a display into a mode, or in a dry run only says it would."}],"role":"symbol"},"doc://HeadwireMac/documentation/HeadwireMac/LiveModeSetter":{"url":"\/documentation\/headwiremac\/livemodesetter","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"LiveModeSetter"}],"title":"LiveModeSetter","navigatorTitle":[{"kind":"identifier","text":"LiveModeSetter"}],"identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/LiveModeSetter","abstract":[{"type":"text","text":"Sets the mode through a CoreGraphics display configuration."}],"role":"symbol"},"doc://HeadwireMac/documentation/HeadwireMac/PairingView":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The pairing window: the code to type on the device, and the QR to scan; once the code is gone,"},{"type":"text","text":" "},{"type":"text","text":"who paired or why it stopped working, with a button for a new one."}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"PairingView","kind":"identifier"}],"url":"\/documentation\/headwiremac\/pairingview","navigatorTitle":[{"text":"PairingView","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/PairingView","title":"PairingView"},"doc://HeadwireMac/documentation/HeadwireMac/Main":{"url":"\/documentation\/headwiremac\/main","type":"topic","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/Main","kind":"symbol","title":"Main","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Main"}],"navigatorTitle":[{"kind":"identifier","text":"Main"}],"abstract":[{"type":"text","text":"Starts the menu-bar helper, or with "},{"type":"codeVoice","code":"--once"},{"type":"text","text":", prints the displays and the plan and exits."}],"role":"symbol"},"doc://HeadwireMac/documentation/HeadwireMac/LiveDisplays":{"url":"\/documentation\/headwiremac\/livedisplays","type":"topic","title":"LiveDisplays","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/LiveDisplays","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"LiveDisplays"}],"navig