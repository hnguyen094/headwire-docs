{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac"},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"type":"text","text":"Headwire Helper, the optional menu-bar app on the Mac."}],"topicSections":[{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/Main","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HeadwireMacApp","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/OnceReport"],"anchor":"Starting","title":"Starting"},{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HelperController","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HelperSettings","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/LiveDisplays","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/EDIDRegistry","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/DisplayChanges","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/ModeSetter","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/LiveModeSetter","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/DryRunModeSetter"],"anchor":"The-display-mode","title":"The display mode"},{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HostController","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/PermissionCenter","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/CableQuestion"],"anchor":"Streaming-and-input","title":"Streaming and input"},{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HelperMenu","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HostMenu","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/SidecarMenu","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/PairingView","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/AboutView"],"anchor":"The-menu-and-windows","title":"The menu and windows"},{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/TransferNotices"],"generated":true,"anchor":"Classes","title":"Classes"},{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/LoginItemMenu","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/TransferMenu","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/WelcomeFeatureRow","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/WelcomeView"],"generated":true,"anchor":"Structures","title":"Structures"},{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/LoginItem","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/MacCues"],"generated":true,"anchor":"Enumerations","title":"Enumerations"},{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HeadwireMacKit","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HeadwireWire"],"generated":true,"anchor":"Extended-Modules","title":"Extended Modules"}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"HeadwireMac is the helper’s AppKit and SwiftUI shell. It reads the world (the online displays from CoreGraphics, their EDIDs from the IORegistry, the permissions macOS has granted, the menu’s choices from the helper’s defaults), hands what it read to "},{"type":"codeVoice","code":"HeadwireMacKit"},{"type":"text","text":"‘s value types, and carries out what they decide: it sets the capture display’s mode and starts or stops the host in "},{"type":"codeVoice","code":"HeadwireMacHost"},{"type":"text","text":" as the menu’s switches change. It owns the menu, the pairing window with its code and QR, the question it puts before trusting a new device on the USB cable, the About window with every licence the helper ships, and the command-line flags. It makes no decision a person sees on its own and holds no streaming, input or pairing code. Headwire works without the helper: the capture card and Bluetooth HID need nothing on the Mac."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The launch flags:"}]},{"type":"termList","items":[{"term":{"inlineContent":[{"type":"codeVoice","code":"--dry-run"}]},"definition":{"content":[{"inlineContent":[{"type":"text","text":"Sets no display mode and posts no input; it logs what it would do instead."}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"type":"codeVoice","code":"--synthetic"}]},"definition":{"content":[{"inlineContent":[{"type":"text","text":"Streams a moving test pattern without Screen Recording, and keeps its key out of the keychain."}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"code":"--once","type":"codeVoice"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Prints the displays, the capture display and the plan, then exits without setting or starting anything."}]}]}},{"term":{"inlineContent":[{"type":"codeVoice","code":"--no-bluetooth"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Never asks for Bluetooth.","type":"text"}]}]}},{"term":{"inlineContent":[{"code":"--trust <key>","type":"codeVoice"}]},"definition":{"content":[{"inlineContent":[{"type":"text","text":"Admits a device’s key fingerprint for this launch without pairing, for development."}],"type":"paragraph"}]}}]}]}],"metadata":{"title":"HeadwireMac","externalID":"HeadwireMac","symbolKind":"module","modules":[{"name":"HeadwireMac"}],"roleHeading":"Command-line Tool","role":"collection"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/headwiremac"]}],"references":{"doc://HeadwireMac/documentation/HeadwireMac/HelperController":{"kind":"symbol","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HelperController","title":"HelperController","url":"\/documentation\/headwiremac\/helpercontroller","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HelperController","kind":"identifier"}],"abstract":[{"text":"Ties the displays, the iPad’s request, and the menu together, and applies the plan.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"HelperController","kind":"identifier"}]},"doc://HeadwireMac/documentation/HeadwireMac/CableQuestion":{"kind":"symbol","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/CableQuestion","title":"CableQuestion","url":"\/documentation\/headwiremac\/cablequestion","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CableQuestion","kind":"identifier"}],"abstract":[{"text":"The question the helper puts before it trusts a new device on the USB cable, while the menu’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"“Ask on this Mac before pairing over USB” is on."}],"role":"symbol","navigatorTitle":[{"text":"CableQuestion","kind":"identifier"}]},"doc://HeadwireMac/documentation/HeadwireMac/DryRunModeSetter":{"kind":"symbol","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/DryRunModeSetter","title":"DryRunModeSetter","url":"\/documentation\/headwiremac\/dryrunmodesetter","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DryRunModeSetter","kind":"identifier"}],"abstract":[{"type":"text","text":"Logs what it would do and touches nothing. The only setter a dry run is given."}],"role":"symbol","navigatorTitle":[{"text":"DryRunModeSetter","kind":"identifier"}]},"doc://HeadwireMac/documentation/HeadwireMac/TransferNotices":{"kind":"symbol","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/TransferNotices","title":"TransferNotices","url":"\/documentation\/headwiremac\/transfernotices","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"TransferNotices"}],"abstract":[{"text":"Notifications about files: one when a file from a device is in Downloads, which shows it in","type":"text"},{"text":" ","type":"text"},{"text":"Finder when clicked, and one when a file could not be sent.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TransferNotices"}]},"doc://HeadwireMac/documentation/HeadwireMac/Main":{"url":"\/documentation\/headwiremac\/main","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/Main","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Main"}],"title":"Main","kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Main"}],"abstract":[{"type":"text","text":"Starts the menu-bar helper, or with "},{"type":"codeVoice","code":"--once"},{"type":"text","text":", prints the displays and the plan and exits."}]},"doc://HeadwireMac/documentation/HeadwireMac/MacCues":{"kind":"symbol","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/MacCues","title":"MacCues","url":"\/documentation\/headwiremac\/maccues","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MacCues","kind":"identifier"}],"abstract":[{"type":"text","text":"What may let a host that couldn’t listen, or a stream that stopped, start again now: the Mac"},{"type":"text","text":" "},{"type":"text","text":"waking, its displays waking, the login session becoming active, or its network changing."}],"role":"symbol","navigatorTitle":[{"text":"MacCues","kind":"identifier"}]},"doc://HeadwireMac/documentation/HeadwireMac/DisplayChanges":{"kind":"symbol","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/DisplayChanges","title":"DisplayChanges","url":"\/documentation\/headwiremac\/displaychanges","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DisplayChanges","kind":"identifier"}],"abstract":[{"type":"text","text":"CoreGraphics display reconfigurations, as a stream."}],"role":"symbol","navigatorTitle":[{"text":"DisplayChanges","kind":"identifier"}]},"doc://HeadwireMac/documentation/HeadwireMac/AboutView":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/AboutView","url":"\/documentation\/headwiremac\/aboutview","