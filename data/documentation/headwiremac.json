":[{"kind":"identifier","text":"PermissionCenter"}],"kind":"symbol","abstract":[{"type":"text","text":"Reads and asks for the permissions the helper’s features need. Reading never prompts; asking"},{"text":" ","type":"text"},{"text":"shows macOS’s own prompt once, then opens the pane in System Settings.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermissionCenter"}],"identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/PermissionCenter","title":"PermissionCenter","url":"\/documentation\/headwiremac\/permissioncenter"},"doc://HeadwireMac/documentation/HeadwireMac/LoginItem":{"abstract":[{"type":"text","text":"The helper as a login item, through "},{"type":"codeVoice","code":"SMAppService.mainApp"},{"type":"text","text":", which works in the sandbox and"},{"type":"text","text":" "},{"type":"text","text":"needs no helper app of its own. Registering may leave it waiting for the person’s approval in"},{"type":"text","text":" "},{"type":"text","text":"System Settings > General > Login Items, which the menu then says."}],"kind":"symbol","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/LoginItem","title":"LoginItem","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LoginItem"}],"type":"topic","url":"\/documentation\/headwiremac\/loginitem","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"LoginItem"}]},"doc://HeadwireMac/documentation/HeadwireMac/ConsoleSession":{"url":"\/documentation\/headwiremac\/consolesession","role":"symbol","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ConsoleSession"}],"identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/ConsoleSession","title":"ConsoleSession","abstract":[{"type":"text","text":"Whether this user’s session has the Mac’s screen, under fast user switching."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"