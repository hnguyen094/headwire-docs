{"abstract":[{"type":"text","text":"Headwire Helper, the optional menu-bar app on the Mac."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/headwiremac"]}],"kind":"symbol","identifier":{"url":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/Main","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HeadwireMacApp","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/OnceReport"],"anchor":"Starting","title":"Starting"},{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HelperController","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HelperSettings","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/LiveDisplays","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/EDIDRegistry","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/DisplayChanges","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/ModeSetter","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/LiveModeSetter","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/DryRunModeSetter"],"anchor":"The-display-mode","title":"The display mode"},{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HostController","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/PermissionCenter","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/PairingQuestion"],"anchor":"Streaming-and-input","title":"Streaming and input"},{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HelperMenu","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HostMenu","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/SidecarMenu","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/PairingView","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/AboutView"],"anchor":"The-menu-and-windows","title":"The menu and windows"},{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/CardCodeOverlay","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HelperApp","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/TransferNotices"],"anchor":"Classes","title":"Classes","generated":true},{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/LoginItemMenu","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/TransferMenu","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/WelcomeFeatureRow","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/WelcomeView"],"anchor":"Structures","title":"Structures","generated":true},{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/ConsoleSession","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/LoginItem","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/MacCues","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/OtherCopy","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/SystemSleep"],"anchor":"Enumerations","title":"Enumerations","generated":true},{"identifiers":["doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HeadwireMacKit","doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HeadwireWire"],"anchor":"Extended-Modules","title":"Extended Modules","generated":true}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"HeadwireMac"}],"title":"HeadwireMac","roleHeading":"Command-line Tool","role":"collection","externalID":"HeadwireMac","symbolKind":"module"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"HeadwireMac is the helper’s AppKit and SwiftUI shell. It reads the world (the online displays from CoreGraphics, their EDIDs from the IORegistry, the permissions macOS has granted, the menu’s choices from the helper’s defaults), hands what it read to "},{"type":"codeVoice","code":"HeadwireMacKit"},{"type":"text","text":"‘s value types, and carries out what they decide: it sets the capture display’s mode and starts or stops the host in "},{"type":"codeVoice","code":"HeadwireMacHost"},{"type":"text","text":" as the menu’s switches change. It owns the menu, the pairing window with its code and QR, the question it puts before trusting a new device on the USB cable, the About window with every licence the helper ships, and the command-line flags. It makes no decision a person sees on its own and holds no streaming, input or pairing code. Headwire works without the helper: the capture card and Bluetooth HID need nothing on the Mac."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The launch flags:"}]},{"type":"termList","items":[{"definition":{"content":[{"inlineContent":[{"text":"Prints the displays, the capture display and the plan, then exits without setting or starting anything.","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"code":"--once","type":"codeVoice"}]}},{"term":{"inlineContent":[{"code":"--no-bluetooth","type":"codeVoice"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Never asks for Bluetooth.","type":"text"}]}]}}]},{"type":"paragraph","inlineContent":[{"text":"A debug build, or one from ","type":"text"},{"code":"Scripts\/build-app.sh --development","type":"codeVoice"},{"text":", also takes the development flags. A shipping build ignores them, and the ","type":"text"},{"code":"-key value","type":"codeVoice"},{"text":" argument domain too, so no other process can relaunch the helper into trusting a key or into a menu choice nobody made:","type":"text"}]},{"type":"termList","items":[{"term":{"inlineContent":[{"code":"--dry-run","type":"codeVoice"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets no display mode and posts no input; it logs what it would do instead. Also "},{"code":"HEADWIRE_DRY_RUN=1","type":"codeVoice"},{"type":"text","text":"."}]}]}},{"term":{"inlineContent":[{"code":"--synthetic","type":"codeVoice"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Streams a moving test pattern without Screen Recording, and keeps its key out of the keychain."}]}]}},{"term":{"inlineContent":[{"code":"--trust <key>","type":"codeVoice"}]},"definition":{"content":[{"inlineContent":[{"text":"Admits a device’s key fingerprint for this launch without pairing.","type":"text"}],"type":"paragraph"}]}}]}]}],"references":{"doc://HeadwireMac/documentation/HeadwireMac/EDIDRegistry":{"role":"symbol","type":"topic","navigatorTitle":[{"text":"EDIDRegistry","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Finds display EDIDs in the IORegistry with public IOKit calls."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EDIDRegistry"}],"identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/EDIDRegistry","title":"EDIDRegistry","url":"\/documentation\/headwiremac\/edidregistry"},"doc://HeadwireMac/documentation/HeadwireMac/MacCues":{"url":"\/documentation\/headwiremac\/maccues","role":"symbol","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MacCues"}],"identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/MacCues","title":"MacCues","abstract":[{"type":"text","text":"What may let a host that couldn’t listen, or a stream that stopped, start again now: the Mac"},{"type":"text","text":" "},{"type":"text","text":"waking, its displays waking, the login session becoming active, or its network changing."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MacCues"}]},"doc://HeadwireMac/documentation/HeadwireMac/CardCodeOverlay":{"abstract":[{"type":"text","text":"The live presenter: a borderless panel above everything in the middle of the screen the capture"},{"type":"text","text":" "},{"type":"text","text":"card shows, with the QR and a line saying which device is pairing."}],"kind":"symbol","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/CardCodeOverlay","title":"CardCodeOverlay","role":"symbol","navigatorTitle":[{"text":"CardCodeOverlay","kind":"identifier"}],"url":"\/documentation\/headwiremac\/cardcodeoverlay","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CardCodeOverlay","kind":"identifier"}]},"doc://HeadwireMac/documentation/HeadwireMac/TransferMenu":{"role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"TransferMenu"}],"kind":"symbol","abstract":[{"type":"text","text":"The menu’s Files section: send a file to each device that takes them, and the files moving now."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TransferMenu"}],"identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/TransferMenu","title":"TransferMenu","url":"\/documentation\/headwiremac\/transfermenu"},"doc://HeadwireMac/documentation/HeadwireMac/DryRunModeSetter":{"abstract":[{"type":"text","text":"Logs what it would do and touches nothing. The only setter a dry run is given."}],"navigatorTitle":[{"kind":"identifier","text":"DryRunModeSetter"}],"identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/DryRunModeSetter","type":"topic","title":"DryRunModeSetter","url":"\/documentation\/headwiremac\/dryrunmodesetter","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DryRunModeSetter"}]},"doc://HeadwireMac/documentation/HeadwireMac/HeadwireMacApp":{"url":"\/documentation\/headwiremac\/headwiremacapp","type":"topic","title":"HeadwireMacApp","identifier":"doc:\/\/HeadwireMac\/documentation\/HeadwireMac\/HeadwireMacApp","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeadwireMacApp"}],"navigatorTitle":[{"kind":"identifier","text":"HeadwireMacApp"}],"abstract":[{"type":"text","text":"The menu-bar helper. "},{"type":"codeVoice","code":"LSUIElement"},{"type":"text","text":" in its Info.plist keeps it out of the Dock."