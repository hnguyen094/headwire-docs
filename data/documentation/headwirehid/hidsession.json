{"abstract":[{"type":"text","text":"Turns input events into reports and feeds them to one transport, off the main actor."}],"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/HIDSession\/init(transport:)"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/HIDSession\/abandonBacklog()","doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/HIDSession\/disconnect()","doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/HIDSession\/flush()","doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/HIDSession\/handle(_:)","doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/HIDSession\/keepalive()","doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/HIDSession\/run()"]}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/HeadwireHID\/s8SendableP","doc:\/\/HeadwireHID\/s16SendableMetatypeP","doc:\/\/HeadwireHID\/ScA"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HIDSession","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Events update the keyboard and pointer state and land in a report coalescer. One sender","type":"text"},{"text":" ","type":"text"},{"text":"drains it, a batch at a time, awaiting the transport between batches; motion that arrives","type":"text"},{"text":" ","type":"text"},{"text":"during that await coalesces, so a slow link sends fewer, larger motion reports instead of","type":"text"},{"text":" ","type":"text"},{"text":"building a backlog. While anything is held, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/HIDSession\/run()","type":"reference"},{"text":" resends it every 100 ms as a keepalive,","type":"text"},{"text":" ","type":"text"},{"text":"so a link that drops and comes back while a key is held carries the held state again. With","type":"text"},{"text":" ","type":"text"},{"text":"nothing held, the keepalive’s timer doesn’t run, so an idle session never wakes.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/headwirehid\/hidsession"]}],"kind":"symbol","seeAlsoSections":[{"anchor":"Session","generated":true,"title":"Session","identifiers":["doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/HIDEvent"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/HeadwireHID\/documentation\/HeadwireHID"]]},"sections":[],"identifier":{"url":"doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/HIDSession","interfaceLanguage":"swift"},"metadata":{"role":"symbol","symbolKind":"class","externalID":"s:11HeadwireHID10HIDSessionC","navigatorTitle":[{"kind":"identifier","text":"HIDSession"}],"title":"HIDSession","modules":[{"name":"HeadwireHID"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HIDSession","kind":"identifier"}],"roleHeading":"Class"},"references":{"doc://HeadwireHID/documentation/HeadwireHID/HIDSession":{"title":"HIDSession","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"HIDSession"}],"abstract":[{"type":"text","text":"Turns input events into reports and feeds them to one transport, off the main actor."}],"identifier":"doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/HIDSession","navigatorTitle":[{"kind":"identifier","text":"HIDSession"}],"url":"\/documentation\/headwirehid\/hidsession","kind":"symbol","type":"topic"},"doc://HeadwireHID/documentation/HeadwireHID/HIDSession/init(transport:)":{"identifier":"doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/HIDSession\/init(transport:)","kind":"symbol",