{"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/HIDReportDescriptor\/composite","isActive":true,"type":"reference"},{"text":" declares one device with four application collections, told apart by a report ID byte that prefixes every report. The same IDs appear in the Report Reference descriptor of each Report characteristic, so the descriptor and the GATT layout change together. ","type":"text"},{"identifier":"doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/HIDReport\/bytes","isActive":true,"type":"reference"},{"text":" is the ID followed by the body; the peripheral transport sends one report per notification. Multi-byte fields are little-endian.","type":"text"}]},{"rows":[[[{"inlineContent":[{"text":"ID","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Collection","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Bytes after the ID"}]}]],[[{"inlineContent":[{"text":"1","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Keyboard"}],"type":"paragraph"}],[{"inlineContent":[{"text":"8","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"2","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Relative mouse","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"7","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"3","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Absolute pointer","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"4","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Consumer control","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"2","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"Keyboard-report-1","type":"heading","level":3,"text":"Keyboard, report 1"},{"type":"paragraph","inlineContent":[{"text":"A boot-layout keyboard.","type":"text"}]},{"rows":[[[{"inlineContent":[{"text":"Byte","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Field","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"0","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Modifier bits, usages 0xE0 to 0xE7: bit 0 Left Control, 1 Left Shift, 2 Left Option, 3 Left Command, 4 to 7 the same on the right","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"1","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Reserved, always 0","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"2 to 7","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Six key slots, keyboard-page usages 0 to 255, in press order, unused slots 0","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"text":"If more than six non-modifier keys are held, every slot carries ErrorRollOver (0x01), which tells the Mac the key state is unknown rather than letting it see a wrong subset.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The keyboard also declares a one-byte output report: five LED bits (bit 0 Num Lock, 1 Caps Lock, 2 Scroll Lock, 3 Compose, 4 Kana) and three bits of padding. ","type":"text"},{"identifier":"doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/KeyboardLEDs\/init(outputReport:)","isActive":true,"type":"reference"},{"text":" reads it with the ID byte first.","type":"text"}]},{"anchor":"Relative-mouse-report-2","type":"heading","level":3,"text":"Relative mouse, report 2"},{"rows":[[[{"inlineContent":[{"text":"Byte","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Field","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"0","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Buttons 1 to 5 in bits 0 to 4, three bits of padding","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"1 and 2","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"X delta, ","type":"text"},{"code":"Int16","type":"codeVoice"},{"text":", -32767 to 32767, positive rightward","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"3 and 4","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Y delta, ","type":"text"},{"code":"Int16","type":"codeVoice"},{"text":", -32767 to 32767, positive downward","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"5","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Vertical wheel, ","type":"text"},{"code":"Int8","type":"codeVoice"},{"text":", -127 to 127, positive scrolls up","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"6","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"AC Pan (consumer usage 0x0238), ","type":"text"},{"code":"Int8","type":"codeVoice"},{"text":", -127 to 127, positive scrolls right","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"text":"The encoder does not clamp. -32768 and -128 fall outside the declared logical range, so keep motion within ","type":"text"},{"identifier":"doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/RelativeMouseReport\/motionLimit","isActive":true,"type":"reference"},{"text":" and scroll within ","type":"text"},{"identifier":"doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/RelativeMouseReport\/scrollLimit","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"anchor":"Absolute-pointer-report-3","type":"heading","level":3,"text":"Absolute pointer, report 3"},{"rows":[[[{"inlineContent":[{"text":"Byte","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Field","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"0 and 1","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"X, ","type":"text"},{"code":"UInt16","type":"codeVoice"},{"text":", 0 to 32767","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"2 and 3","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Y, ","type":"text"},{"code":"UInt16","type":"codeVoice"},{"text":", 0 to 32767","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"text":"macOS maps the range onto the screen. This report declares no buttons. macOS folds the button fields of every report into one state, element by element in descriptor order, and each keeps its last value, so buttons here would override report 2’s with stale bits. A tap placed with this report sends its button on report 2, and so does a drag’s motion while a button is held, as relative counts.","type":"text"}]},{"anchor":"Consumer-control-report-4","type":"heading","level":3,"text":"Consumer control, report 4"},{"rows":[[[{"inlineContent":[{"text":"Byte","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Field","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"0 and 1","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"One held consumer-page usage, 0 to 0x3FF, or 0 when released","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/ConsumerUsage","type":"reference"},{"text":" lists the usages the app sends: brightness, media, volume, and the Globe key.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/headwirehid\/reportdescriptor"]}],"sections":[],"identifier":{"url":"doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/ReportDescriptor","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"HeadwireHID"}],"roleHeading":"API Collection","role":"collectionGroup","title":"The report descriptor"},"abstract":[{"type":"text