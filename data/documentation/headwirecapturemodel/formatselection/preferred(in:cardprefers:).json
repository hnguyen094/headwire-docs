{"text":": [","kind":"text"},{"text":"CaptureFormat","kind":"typeIdentifier","preciseIdentifier":"s:20HeadwireCaptureModel0B6FormatV","identifier":"doc:\/\/HeadwireCaptureModel\/documentation\/HeadwireCaptureModel\/CaptureFormat"},{"text":"], ","kind":"text"},{"text":"cardPrefers","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"card","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"CardPreferredMode","kind":"typeIdentifier","preciseIdentifier":"s:20HeadwireCaptureModel17CardPreferredModeV","identifier":"doc:\/\/HeadwireCaptureModel\/documentation\/HeadwireCaptureModel\/CardPreferredMode"},{"text":"? = .none) -> ","kind":"text"},{"text":"ResolvedFormat","kind":"typeIdentifier","preciseIdentifier":"s:20HeadwireCaptureModel14ResolvedFormatV","identifier":"doc:\/\/HeadwireCaptureModel\/documentation\/HeadwireCaptureModel\/ResolvedFormat"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"text":"Takes the card’s own preferred mode first, where the list offers it: its resolution and rate,","type":"text"},{"text":" ","type":"text"},{"text":"then its resolution, then its rate, so a card that prefers 59.94 runs at 59.94 even where the","type":"text"},{"text":" ","type":"text"},{"text":"same mode offers 60. Then, as where the card says nothing: frame rate; pixel count up to","type":"text"},{"text":" ","type":"text"},{"text":"1080p, since a Mac’s text is too soft below it; uncompressed over compressed, since a decode","type":"text"},{"text":" ","type":"text"},{"text":"stage adds latency; the card’s own pixel format; 16:9, since a card’s taller modes squash a","type":"text"},{"text":" ","type":"text"},{"text":"16:9 source to fit; full pixel count; then ","type":"text"},{"type":"reference","identifier":"doc:\/\/HeadwireCaptureModel\/documentation\/HeadwireCaptureModel\/PixelFormat\/rank","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"There is no standing preference for any one mode. The reference implementation ranked by","type":"text"},{"text":" ","type":"text"},{"text":"pixels per second, which puts 4K30 Motion JPEG above 1080p60 YUY2; a KVM console wants the","type":"text"},{"text":" ","type":"text"},{"text":"latency of the second.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/headwirecapturemodel\/formatselection\/preferred(in:cardprefers:)"]}],"kind":"symbol","references":{"doc://HeadwireCaptureModel/documentation/HeadwireCaptureModel/FormatSelection":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FormatSelection"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"FormatSelection"}],"kind":"symbol","identifier":"doc:\/\/HeadwireCaptureModel\/documentation\/HeadwireCaptureModel\/FormatSelection","url":"\/documentation\/headwirecapturemodel\/formatselection","title":"FormatSelection","abstract":[{"type":"text","text":"The resolution, frame rate, and pixel format the user chose, independent of any one device’s format list."}]},"doc://HeadwireCaptureModel/documentation/HeadwireCaptureModel/PixelFormat/rank":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rank"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/HeadwireCaptureModel\/documentation\/HeadwireCaptureModel\/PixelFormat\/rank","url":"\/documentation\/headwirecapturemodel\/pixelformat\/rank","title":"rank","abstract":[{"text":"How strongly to prefer this format when two formats are otherwise equal; higher is better.","type":"text"}]},"doc://HeadwireCaptureModel/documentation/HeadwireCaptureModel/CardPreferredMode":{"identifier":"doc:\/\/HeadwireCaptureModel\/documenta