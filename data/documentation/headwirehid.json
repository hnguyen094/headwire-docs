vice and the source mode service. It also re-exports ","type":"text"},{"code":"HeadwireGATTContract","type":"codeVoice"},{"text":", so its users get the source mode request and the pairing offer. It does not recognise touches, gestures, or keys; that is the app’s input layer, which hands it ","type":"text"},{"code":"InputEvent","type":"codeVoice"},{"text":" values from HeadwireInput. It does not carry the helper link, which belongs to HeadwireStream.","type":"text"}]}]}],"hierarchy":{"paths":[[]]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://HeadwireHID/documentation/HeadwireHID/PeripheralHIDTransport":{"kind":"symbol","identifier":"doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/PeripheralHIDTransport","fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"text":"PeripheralHIDTransport","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"PeripheralHIDTransport"}],"type":"topic","url":"\/documentation\/headwirehid\/peripheralhidtransport","abstract":[{"text":"The iPad as a Bluetooth LE keyboard and mouse (HID over GATT), with no hardware in between.","type":"text"}],"title":"PeripheralHIDTransport","role":"symbol"},"doc://HeadwireHID/documentation/HeadwireHID/MouseButton":{"role":"symbol","identifier":"doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/MouseButton","title":"MouseButton","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MouseButton","kind":"identifier"}],"navigatorTitle":[{"text":"MouseButton","kind":"identifier"}],"type":"topic","abstract":[{"text":"One of the five mouse buttons the pointer reports declare.","type":"text"}],"kind":"symbol","url":"\/documentation\/headwirehid\/mousebutton"},"doc://HeadwireHID/documentation/HeadwireHID/KeyboardLEDs":{"type":"topic","url":"\/documentation\/headwirehid\/keyboardleds","kind":"symbol","identifier":"doc:\/\/HeadwireHID\/documentation\/HeadwireHID\/KeyboardLEDs","role":"symbol","abstract":[{"text":"The