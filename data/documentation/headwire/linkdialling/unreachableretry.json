{"kind":"symbol","identifier":{"url":"doc:\/\/com.nth.headwire\/documentation\/Headwire\/LinkDialling\/unreachableRetry","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The fixed wait before a failed link is dialled again when no cue will come."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"unreachableRetry"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing reports a Mac waking while its Bonjour listing stayed up (a sleep proxy keeps it),"},{"type":"text","text":" "},{"type":"text","text":"or a helper that starts listening again on an interface that never went away. So while"},{"type":"text","text":" "},{"type":"text","text":"the app is in front and the screen says the Mac can’t be reached, a failed link is dialled"},{"type":"text","text":" "},{"type":"text","text":"again after this wait; it never grows, and it never runs in the background or while"},{"type":"text","text":" "},{"type":"text","text":"something else is on screen."}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.nth.headwire\/documentation\/Headwire","doc:\/\/com.nth.headwire\/documentation\/Headwire\/LinkDialling"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"externalID":"s:8Headwire12LinkDiallingV16unreachableRetrys8DurationVvpZ","symbolKind":"property","role":"symbol","title":"unreachableRetry","modules":[{"name":"Headwire"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unreachableRetry","kin