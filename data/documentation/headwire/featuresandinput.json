l","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"ConnectivityFeature","kind":"identifier"}],"identifier":"doc:\/\/com.nth.headwire\/documentation\/Headwire\/ConnectivityFeature","url":"\/documentation\/headwire\/connectivityfeature","title":"ConnectivityFeature","kind":"symbol","abstract":[{"text":"Keeps each video and input path’s health, chooses the live pair, and decides when a backup runs.","type":"text"}]},"doc://com.nth.headwire/documentation/Headwire/TouchInputMapper":{"type":"topic","title":"TouchInputMapper","identifier":"doc:\/\/com.nth.headwire\/documentation\/Headwire\/TouchInputMapper","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TouchInputMapper"}],"navigatorTitle":[{"kind":"identifier","text":"TouchInputMapper"}],"url":"\/documentation\/headwire\/touchinputmapper","role":"symbol","kind":"symbol","abstract":[{"text":"Turns touch gestures into input events for the pointer mode in effect.","type":"text"}]},"doc://com.nth.headwire/documentation/Headwire/SoundFeature":{"type":"topic","title":"SoundFeature","identifier":"doc:\/\/com.nth.headwire\/documentation\/Headwire\/SoundFeature","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SoundFeature","kind":"identifier"}],"navigatorTitle":[{"text":"SoundFeature","kind":"identifier"}],"url":"\/documentation\/headwire\/soundfeature","role":"symbol","kind":"symbol","abstract":[{"text":"Plays the Mac’s sound from whichever video is shown, at the person’s volume, in step with the picture.","type":"text"}]},"doc://com.nth.headwire/documentation/Headwire":{"type":"topic","role":"collection","identifier":"doc:\/\/com.nth.headwire\/documentation\/Headwire","url":"\/documentation\/headwire","title":"Headwire","abstract":[{"type":"text","text":"The iPad and iPhone app: one screen that shows the Mac’s picture and sends the Mac input from touch, trackpad, mouse, Pencil, and keyboard."}],"kind":"symbol"},"doc://com.nth.headwire/documentation/Headwire/AppView":{"kind":"symbol","identifier":"doc:\/\/com.nth.headwire\/documentation\/Headwire\/AppView","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AppView"}],"abstract":[{"text":"The one screen: the stream edge to edge with the input surface over it, or, at a fold, the","type":"text"},{"text":" ","type":"text"},{"text":"stream before the fold and a trackpad after it, and the floating settings and keyboard buttons.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"AppView"}],"url":"\/documentation\/headwire\/appview","title":"AppView"},"doc://com.nth.headwire/documentation/Headwire/UntypedTextFeature":{"type":"topic","kind":"symbol","url":"\/documentation\/headwire\/untypedtextfeature","abstract":[{"text":"Says which characters Bluetooth couldn’t type, because the Mac’s keyboard layout has no keys for them.","type":"text"}],"identifier":"doc:\/\/com.nth.headwire\/documentation\/Headwire\/UntypedTextFeature","title":"UntypedTextFeature","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UntypedTextFeature","kind":"identifier"}],"navigatorTitle":[{"text":"UntypedTextFeature","kind":"identifier"}],"role":"symbol"},"doc://com.nth.headwire/documentation/Headwire/InputSurfaceUIView":{"navigatorTitle":[{"text":"InputSurfaceUIView","kind":"identifier"}],"type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InputSurfaceUIView","kind":"identifier"}],"title":"InputSurfaceUIView","identifier":"doc:\/\/com.nth.headwire\/documentation\/Headwire\/InputSurfaceUIView","url":"\/documentation\/headwire\/inputsurfaceuiview","kind":"symbol","abstract":[{"text":"The transparent view over the video that takes keyboard, mouse, and touch input for the Mac.","type":"text"}]},"doc://com.nth.headwire/documentation/Headwire/AppFeature":{"type":"topic","kind":"symbol","url":"\/documentation\/headwire\/appfeature","abstract":[{"type":"text","text":"The one screen: the stream, a settings button that dims when idle, the key row, and the settings sheet."}],"identifier":"doc:\/\/com.nth.headwire\/documentation\/Headwire\/AppFeature","title":"AppFeature","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AppFeature","kind":"identifier"}],"navigatorTitle":[{"text":"AppFeature","kind":"identifier"}],"role":"symbol"},"doc://com.nth.headwire/documentation/Headwire/ConnectivityStatus":{"type":"topic","abstract":[{"type":"text","text":"What the connectivity feature tells the rest of the app: the live pair, how each is doing, and the backup."}],"navigatorTitle":[{"kind":"identifier","text":"ConnectivityStatus"}],"role":"symbol","kind":"symbol","title":"ConnectivityStatus","identifier":"doc:\/\/com.nth.headwire\/documentation\/Headwire\/ConnectivityStatus","url":"\/documentation\/headwire\/connectivitystatus","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConnectivityStatus"}]},"doc://com.nth.headwire/documentation/Headwire/InputSurface":{"kind":"symbol","identifier":"doc:\/\/com.nth.headwire\/documentation\/Headwire\/InputSurface","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InputSurface","kind":"identifier"}],"abstract":[{"type":"text","text":"Puts the input surface over the video, handing it the mode and the Mac’s content rect the reducer owns."}],"navigatorTitle":[{"text":"InputSurface","kind":"identifier"}],"url":"\/documentation\/headwire\/inputsurface","title":"InputSurface"},"doc://com.nth.headwire/documentation/Headwire/TextEdit":{"type":"topic","title":"TextEdit","identifier":"doc:\/\/com.nth.headwire\/documentation\/Headwire\/TextEdit","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TextEdit"}],"navigatorTitle":[{"text":"TextEdit","kind":"identifier"}],"url":"\/documentation\/headwire\/textedit","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"One change to the on-screen keyboard’s text, as the Mac must see it: backspaces, then new text."}]},"doc://com.nth.headwire/documentation/Headwire/KeyboardTracker":{"type":"topic","title":"KeyboardTracker","identifier":"doc:\/\/com.nth.headwire\/documentation\/Headwire\/KeyboardTracker","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyboardTracker","kind":"identifier"}],"navigatorTitle":[{"text":"KeyboardTracker","kind":"identifier"}],"url":"\/documentation\/headwire\/keyboardtracker","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Turns hardware key presses into key-down and key-up events, each key down at most once."}]}}}