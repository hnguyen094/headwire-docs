{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.nth.headwire\/documentation\/Headwire\/StoredFile"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StoredFile","kind":"identifier"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"When the file, or any element in it, doesn’t decode, the original is copied beside it as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"<name>.corrupt"},{"text":" before the next write replaces it, and the app carries on with what did decode,","type":"text"},{"text":" ","type":"text"},{"text":"or the default. An original already kept aside is never written over: the first is the one","type":"text"},{"text":" ","type":"text"},{"text":"that held the most, as when an earlier build reads a later one’s file and drops what it doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"know, then saves without it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A kept original is for support only. Nothing reads it back or offers to restore it, since it","type":"text"},{"text":" ","type":"text"},{"text":"predates whatever the person forgot since; each read of the file names it in the log, so a","type":"text"},{"text":" ","type":"text"},{"text":"sysdiagnose shows it is there. One per file, never written over, so they never pile up.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"title":"StoredFile","externalID":"s:8Headwire10StoredFileO","symbolKind":"enum","modules":[{"name":"Headwire"}],"roleHeading":"Enumeration","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StoredFile","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"StoredFile","kind":"identifier"}]},"kind":"symbol","topicSections":[{"anchor":"Struc