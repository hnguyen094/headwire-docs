{"identifier":{"url":"doc:\/\/com.nth.headwire\/documentation\/Headwire\/TouchInputMapper\/pen(_:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pen","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"touch","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8Headwire8PenTouchV","text":"PenTouch","kind":"typeIdentifier","identifier":"doc:\/\/com.nth.headwire\/documentation\/Headwire\/PenTouch"},{"text":") -> [","kind":"text"},{"text":"InputEvent","kind":"typeIdentifier","preciseIdentifier":"s:13HeadwireInput0B5EventO"},{"text":"]","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Only the picture takes the Pencil, as it does a finger: a hover or a tip off it sends"},{"type":"text","text":" "},{"type":"text","text":"nothing, so a Pencil over the letterbox never trips a Hot Corner, raises the Dock or clicks"},{"type":"text","text":" "},{"type":"text","text":"at the Mac’s edge. A Pencil leaving the picture leaves range where it last was. A stroke"},{"type":"text","text":" "},{"type":"text","text":"that started on the picture follows the tip past its edge, clamped, and lifts there."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"While the Pencil can’t point, before the video is laid out or with pointing turned off, a"},{"type":"text","text":" "},{"type":"text","text":"tip that was down lifts once where it last touched, so it never stays held on the Mac."}],"type":"paragraph"}]}],"metadata":{"title":"pen(_:)","extendedModule":"Headwire","externalID":"s:8Headwire16TouchInputMapperV3penySay0aC00C5EventO