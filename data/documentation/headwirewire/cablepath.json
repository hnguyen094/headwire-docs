{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/CablePath"},"abstract":[{"text":"Whether this device’s connection to a Mac runs over the USB cable, as this device sees it: what","type":"text"},{"text":" ","type":"text"},{"text":"a cable pairing’s ask claims, and what a link dialled as the cable must be.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireTransport","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireTLS","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireParameters","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireConnection","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireConnectionError","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireListener","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireAdmission","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireOrigin","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireBrowser","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireEndpoint","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireListing","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WirePathInfo","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/InterfaceAddresses"],"generated":true,"anchor":"Transport","title":"Transport"}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/CablePath\/Interface","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/CablePath\/OwnAddress"],"generated":true,"anchor":"Structures","title":"Structures"},{"identifiers":["doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/CablePath\/check(remote:scope:own:)","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/CablePath\/isLinkLocal(_:)","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/CablePath\/isPeerToPeer(_:)","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/CablePath\/scope(ofEndpoint:)","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/Ca