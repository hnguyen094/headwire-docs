{"hierarchy":{"paths":[["doc:\/\/HeadwireWire\/documentation\/HeadwireWire"]]},"kind":"article","abstract":[{"text":"How the iPad and the Mac helper frame, secure, and evolve the messages between them.","type":"text"}],"sections":[],"variants":[{"paths":["\/documentation\/headwirewire\/wireformat"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireFormat"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"The wire format","role":"article","modules":[{"name":"HeadwireWire"}],"roleHeading":"Article"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The helper link is one TCP connection per session, inside TLS 1.3. Everything on it is a"},{"type":"text","text":" "},{"identifier":"doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireMessage","type":"reference","isActive":true},{"type":"text","text":": a fixed header followed by a payload whose meaning depends on the message’s"},{"type":"text","text":" "},{"type":"text","text":"kind."}],"type":"paragraph"},{"level":3,"text":"The header","anchor":"The-header","type":"heading"},{"inlineContent":[{"type":"text","text":"Every message starts with 14 bytes, big endian:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Bytes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Field","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Contents","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"1","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Kind"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireMessageKind","isActive":true,"type":"reference"},{"type":"text","text":" raw value"}]}]],[[{"type":"paragraph","inl