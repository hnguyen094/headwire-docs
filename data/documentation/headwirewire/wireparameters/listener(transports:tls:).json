text":" "},{"type":"text","text":"for a tunnel: a VPN’s utun or ipsec interface is "},{"type":"codeVoice","code":".other"},{"type":"text","text":". Whether a listener holds inbound"},{"type":"text","text":" "},{"type":"text","text":"connections to its prohibited types is unmeasured, so "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireOrigin"},{"type":"text","text":" also refuses a VPN or"},{"type":"text","text":" "},{"type":"text","text":"internet source before the connection starts."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/HeadwireWire\/documentation\/HeadwireWire","doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireParameters"]]},"identifier":{"url":"doc:\/\/HeadwireWire\/documentation\/HeadwireWire\/WireParameters\/listener(transports:tls:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Parameters for a listener that serves every transport in "},{"type":"codeVoice","code":"transports"},{"type":"text","text":"."}],"metadata":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listener","kind":"identifier"},{"text":"(","kind":"text"},{"text":"transports","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","preciseIdentifier":"s:Sh","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:12HeadwireWire0B9TransportO","text":"WireTransport","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"tls","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7Network13NWProtocolTLSC","text":"NWProtocolTLS","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Network13NWProtocolTLSC7OptionsC","text":"Options","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"NWParameters","preciseIdentifier":"s:7Network12NWParametersC","kind":"typeIdentifier"}],"modules":[{"name":"Headw