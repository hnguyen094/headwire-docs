cumentation\/HeadwireMacKit\/FeatureState\/needs(_:)","title":"FeatureState.needs(_:)","kind":"symbol","role":"symbol"},"doc://HeadwireMacKit/documentation/HeadwireMacKit/FeatureState/needsStreaming":{"url":"\/documentation\/headwiremackit\/featurestate\/needsstreaming","abstract":[{"type":"text","text":"The virtual display’s toggle is on and streaming does not run."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"needsStreaming","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/FeatureState\/needsStreaming","title":"FeatureState.needsStreaming","kind":"symbol","role":"symbol"},"doc://HeadwireMacKit/documentation/HeadwireMacKit/HelperBuild/current":{"role":"symbol","abstract":[{"type":"text","text":"The build this binary is: Direct only with "},{"code":"HEADWIRE_PRIVATE_API","type":"codeVoice"},{"type":"text","text":", input only with"},{"type":"text","text":" "},{"code":"HEADWIRE_HELPER_INPUT","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","identifier":"doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/HelperBuild\/current","type":"topic","title":"current","url":"\/documentation\/headwiremackit\/helperbuild\/current","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"current","kind":"identifier"},{"text":": ","kind":"text"},{"text":"HelperBuild","kind":"typeIdentifier","preciseIdentifier":"s:14HeadwireMacKit11HelperBuildV"}]},"doc://HeadwireMacKit/documentation/HeadwireMacKit/Unavailability/notOnThisMacOS":{"role":"symbol","title":"Unavailability.notOnThisMacOS","identifier":"doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/Unavailability\/notOnThisMacOS","type":"topic","abstract":[{"type":"text","text":"The virtual display, whose private macOS interface this macOS no longer has as this build"},{"type":"text","text":" "},{"type":"text","text":"calls it, as 