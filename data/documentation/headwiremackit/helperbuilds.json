his Mac begin only when the person turns them on. Asking before USB"},{"type":"text","text":" "},{"type":"text","text":"pairing is off too, since a headless Mac has nobody at it to answer."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HelperToggles"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"HelperToggles"}],"identifier":"doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/HelperToggles","kind":"symbol"},"doc://HeadwireMacKit/documentation/HeadwireMacKit/Unavailability":{"title":"Unavailability","url":"\/documentation\/headwiremackit\/unavailability","abstract":[{"type":"text","text":"Why this build cannot do a feature."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Unavailability"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Unavailability"}],"identifier":"doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/Unavailability","kind":"symbol"},"doc://HeadwireMacKit/documentation/HeadwireMacKit/HelperBuild/launchLine(version:dryRun:)":{"url":"\/documentation\/headwiremackit\/helperbuild\/launchline(version:dryrun:)","identifier":"doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/HelperBuild\/launchLine(version:dryRun:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"launchLine"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"version"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"dryRun"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"The log’s launch line: the version, the build, whether input is compiled in."}],"ti