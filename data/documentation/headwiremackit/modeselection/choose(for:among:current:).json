","text":"Only one-pixel-per-point modes of exactly the target size qualify, so a HiDPI “looks like"},{"type":"text","text":" "},{"type":"text","text":"1920x1080” mode on a 4K timing is never chosen. Interlaced and stretched modes and modes"},{"type":"text","text":" "},{"type":"text","text":"macOS does not offer for the desktop are skipped. Of the rest, the rate nearest the target"},{"type":"text","text":" "},{"text":"wins: exact 60.00 beats 59.94 for a 60 Hz target, and 59.94 beats 60.00 for a 59.94 one.","type":"text"},{"text":" ","type":"text"},{"text":"A rate more than half a hertz off does not qualify, so 120 Hz never stands in for 60. A","type":"text"},{"text":" ","type":"text"},{"text":"mode reporting no rate qualifies only when no mode reports one. Ties go to the lower mode","type":"text"},{"text":" ","type":"text"},{"text":"ID, so the answer does not depend on list order.","type":"text"}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"title":"choose(for:among:current:)","modules":[{"name":"HeadwireMacKit"}],"role":"symbol","roleHeading":"Type Method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"choose","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14HeadwireMacKit10ModeTargetV","text":"ModeTarget","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"among","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:14HeadwireMacKit17DisplayModeOptionV","text":"DisplayModeOption","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"current","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14HeadwireMacKit17DisplayModeOptionV","text":"DisplayModeOption","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"preciseIdentifier":"s:14HeadwireMacKit13ModeSelectionO","text":"ModeSelection","ki