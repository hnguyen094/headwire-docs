"wins: exact 60.00 beats 59.94 for a 60 Hz target, and 59.94 beats 60.00 for a 59.94 one."},{"type":"text","text":" "},{"type":"text","text":"A rate more than half a hertz off does not qualify, so 120 Hz never stands in for 60. A"},{"type":"text","text":" "},{"type":"text","text":"mode reporting no rate qualifies only when no mode reports one. Ties go to the lower mode"},{"type":"text","text":" "},{"type":"text","text":"ID, so the answer does not depend on list order."}]}],"kind":"content"}],"references":{"doc://HeadwireMacKit/documentation/HeadwireMacKit/ModeSelection/choose(for:among:current:)":{"role":"symbol","title":"choose(for:among:current:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"choose","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14HeadwireMacKit10ModeTargetV","text":"ModeTarget","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"among","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:14HeadwireMacKit17DisplayModeOptionV","text":"DisplayModeOption","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"current","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14HeadwireMacKit17DisplayModeOptionV","text":"DisplayModeOption","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"preciseIdentifier":"s:14HeadwireMacKit13ModeSelectionO","text":"ModeSelection","kind":"typeIdentifier"}],"url":"\/documentation\/headwiremackit\/modeselection\/choose(for:among:current:)","abstract":[{"text":"Picks the mode for ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" among ","type":"text"},{"code":"modes","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/ModeSelection\/choose(for:among:current:)","type":"topic","kind":"symb