y, so 120 Hz never stands in for 60. A"},{"type":"text","text":" "},{"type":"text","text":"mode reporting no rate qualifies only when no mode reports one. Ties go to the lower mode"},{"type":"text","text":" "},{"type":"text","text":"ID, so the answer does not depend on list order."}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/headwiremackit\/modeselection\/choose(for:among:current:)"]}],"references":{"doc://HeadwireMacKit/documentation/HeadwireMacKit/ModeSelection":{"url":"\/documentation\/headwiremackit\/modeselection","type":"topic","identifier":"doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/ModeSelection","abstract":[{"type":"text","text":"What to do about one display’s mode, given a target."}],"title":"ModeSelection","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ModeSelection"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ModeSelection"}]},"doc://HeadwireMacKit/documentation/HeadwireMacKit/ModeSelection/choose(for:among:current:)":{"url":"\/documentation\/headwiremackit\/modeselection\/choose(for:among:current:)","abstract":[{"type":"text","text":"Picks the mode for "},{"code":"target","type":"codeVoice"},{"type":"text","text":" among "},{"code":"modes","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"choose","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14HeadwireMacKit10ModeTargetV","text":"ModeTarget","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"among","kind":"externalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:14HeadwireMacKit17DisplayModeOptionV","text":"DisplayModeOption","kind":"typeIdent