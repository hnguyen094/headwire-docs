{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit"]]},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/HeadwireMacKit\/SQ","doc:\/\/HeadwireMacKit\/s8SendableP","doc:\/\/HeadwireMacKit\/s16SendableMetatypeP"]}],"seeAlsoSections":[{"title":"The iPad’s source mode request","generated":true,"identifiers":["doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/ListenerRetry"],"anchor":"The-iPads-source-mode-request"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SourceModeLink"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Pure value code, so every transition is tested without a radio. The iPad stops advertising","type":"text"},{"text":" ","type":"text"},{"text":"once the Mac subscribes to HID, so the helper never scans: it asks CoreBluetooth for","type":"text"},{"text":" ","type":"text"},{"text":"peripherals the system already holds a link to, tries each in turn, and follows every one that","type":"text"},{"text":" ","type":"text"},{"text":"carries the source mode service, so each bonded device’s pairing offer is read and answered.","type":"text"},{"text":" ","type":"text"},{"text":"The offer is read when a device is first followed and again for every followed device whenever","type":"text"},{"text":" ","type":"text"},{"text":"a host begins answering, since an offer read while no host listened went unanswered and a","type":"text"},{"text":" ","type":"text"},{"text":"followed device is never discovered again.","type":"text"},{"text":" ","type":"text"},{"text":"It asks again on each retry tick, for a device that connects later. The request followed is","type":"text"},{"text":" ","type":"text"},{"text":"the one most recently sent by any of them: the device whose card was last plugged in or changed.","type":"text"}]}]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"SourceModeLink"}],"roleHeading":"Structure","title":"SourceModeLink","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SourceModeLink"}],"modules":[{"name":"HeadwireMacKit"}],"symbolKind":"struct","externalID":"s:14HeadwireMacKit14SourceModeLinkV","role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/SourceModeLink"},"abstract":[{"text":"The Mac’s side of the source mode characteristic: central events in, commands and a status out.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/headwiremackit\/sourcemodelink"]}],"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/SourceModeLink\/init()"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/SourceModeLink\/request","doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/SourceModeLink\/status-swift.property"],"anchor":"Instance-Properties"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/SourceModeLink\/handle(_:)"],"anchor":"Instance-Methods"},{"title":"Enumerations","generated":true,"identifiers":["doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/SourceModeLink\/Command","doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/SourceModeLink\/Event","doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/SourceModeLink\/Radio","doc:\/\/HeadwireMacKit\/documentation\/HeadwireMacKit\/SourceModeLink\/Status-swift.enum"],"anchor":"Enumerations"}],"kind":"symbol","references":{"doc://Headwire