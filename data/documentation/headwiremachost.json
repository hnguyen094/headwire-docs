{"kind":"symbol","abstract":[{"type":"text","text":"Headwire Helper’s streaming, input and pairing: the code that serves paired devices from the Mac."}],"identifier":{"url":"doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost","interfaceLanguage":"swift"},"metadata":{"role":"collection","modules":[{"name":"HeadwireMacHost"}],"externalID":"HeadwireMacHost","title":"HeadwireMacHost","symbolKind":"module","roleHeading":"Framework"},"hierarchy":{"paths":[[]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/SessionLifecycle"]},{"anchor":"Running-the-host","title":"Running the host","identifiers":["doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/HostCoordinator","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/HostConfiguration","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/SessionInfo","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/StreamHealth","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/HostCounters","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/HostLog"]},{"anchor":"Pairing-and-trust","identifiers":["doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/PairingService","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/TrustList","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/PairedDevice","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/HostKeys","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/LinkAddresses"],"title":"Pairing and trust"},{"anchor":"Input","title":"Input","identifiers":["doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/HostInputActor","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/InputDeviceID","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/InputInjector","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/EventPoster","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/LiveEventPoster","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/DryRunEventPoster"]},{"anchor":"Video","title":"Video","identifiers":["doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/HEVCParameterSets","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/EncodedFrame","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/VirtualDisplayHost"]},{"anchor":"Calibration","title":"Calibration","identifiers":["doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/CalibrationDesk","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/CalibrationPresenter","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/CalibrationOverlay","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/HeadlessCalibrationPresenter","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/CalibrationScreen"]},{"title":"Bluetooth","identifiers":["doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/SourceModeCentral","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/SourceModeRadio","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/SourceModeRadioEvent","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/LiveSourceModeRadio","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/BluetoothPairingAgent","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/BluetoothAgentEvent"],"anchor":"Bluetooth"},{"title":"Classes","generated":true,"identifiers":["doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/HostExchange","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/TransferDesk"],"anchor":"Classes"},{"title":"Structures","generated":true,"identifiers":["doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/ExchangeBoard","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/TransferNotice"],"anchor":"Structures"},{"title":"Extended Modules","generated":true,"identifiers":["doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/HeadwireGATTContract","doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/HeadwireWire"],"anchor":"Extended-Modules"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"HeadwireMacHost runs the helper’s host. It listens for paired devices on the USB cable, the network and Direct wireless over TLS with both keys pinned, captures a display with ScreenCaptureKit, encodes it with a low-latency HEVC encoder, sends the frames and the Mac’s sound to each device, and posts the input each device sends back as "},{"type":"codeVoice","code":"CGEvent"},{"type":"text","text":"s. It also runs the pairing window, keeps the trust list and the helper’s key in the keychain, draws the calibration strip a device asks for, and reads the iPad’s source mode request over the Bluetooth link the Mac already holds for HID. It does not decide what a person sees: the menu’s switches, the permissions, the build and the capture display’s mode are resolved by "},{"type":"codeVoice","code":"HeadwireMacKit"},{"type":"text","text":"’s value types, and the menu itself belongs to the "},{"type":"codeVoice","code":"HeadwireMac"},{"type":"text","text":" app. The wire formats come from "},{"type":"codeVoice","code":"HeadwireWire"},{"type":"text","text":" and the input events from "},{"type":"codeVoice","code":"HeadwireInput"},{"type":"text","text":", so both ends share one implementation. Much of the streaming and input code is derived from "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Saffsanity\/sill"},{"type":"text","text":", under the Apache License 2.0."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The virtual display, Sidecar and the private Bluetooth pairing agent are compiled only into the Direct build and are not documented here."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/headwiremachost"]}],"references":{"doc://HeadwireMacHost/documentation/HeadwireMacHost":{"title":"HeadwireMacHost","type":"topic","identifier":"doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost","kind":"symbol","role":"collection","abstract":[{"text":"Headwire Helper’s streaming, input and pairing: the code that serves paired devices from the Mac.","type":"text"}],"url":"\/documentation\/headwiremachost"},"https://github.com/Saffsanity/sill":{"title":"Sill","type":"link","identifier":"https:\/\/github.com\/Saffsanity\/sill","titleInlineContent":[{"text":"Sill","type":"text"}],"url":"https:\/\/github.com\/Saffsanity\/sill"},"doc://HeadwireMacHost/documentation/HeadwireMacHost/CalibrationPresenter":{"title":"CalibrationPresenter","kind":"symbol","abstract":[{"type":"text","text":"Puts the strip on screen and calls back once per display refresh."}],"type":"topic","identifier":"doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/CalibrationPresenter","role":"symbol","url":"\/documentation\/headwiremachost\/calibrationpresenter","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CalibrationPresenter","kind":"identifier"}],"navigatorTitle":[{"text":"CalibrationPresenter","kind":"identifier"}]},"doc://HeadwireMacHost/documentation/HeadwireMacHost/TransferNotice":{"url":"\/documentation\/headwiremachost\/transfernotice","kind":"symbol","identifier":"doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/TransferNotice","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TransferNotice"}],"navigatorTitle":[{"kind":"identifier","text":"TransferNotice"}],"abstract":[{"text":"The words of a notification about a file, on the Mac.","type":"text"}],"role":"symbol","type":"topic","title":"TransferNotice"},"doc://HeadwireMacHost/documentation/HeadwireMacHost/EventPoster":{"title":"EventPoster","type":"topic","identifier":"doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/EventPoster","kind":"symbol","fragments":[{"kind":"keyword","tex