"},{"type":"text","text":" "},{"type":"text","text":"with their interface first (the USB cable’s among them), then the network’s."}],"url":"\/documentation\/headwiremachost\/linkaddresses"},"doc://HeadwireMacHost/documentation/HeadwireMacHost/VirtualDisplayHost":{"role":"symbol","abstract":[{"type":"text","text":"Makes and removes the extended display a device asked for."}],"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"VirtualDisplayHost"}],"kind":"symbol","title":"VirtualDisplayHost","navigatorTitle":[{"text":"VirtualDisplayHost","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/VirtualDisplayHost","url":"\/documentation\/headwiremachost\/virtualdisplayhost"},"doc://HeadwireMacHost/documentation/HeadwireMacHost/HostInputActor":{"url":"\/documentation\/headwiremachost\/hostinputactor","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HostInputActor","kind":"identifier"}],"title":"HostInputActor","type":"topic","navigatorTitle":[{"text":"HostInputActor","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Where helper input is posted: one serial queue of its own, never the main actor."}],"identifier":"doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/HostInputActor"},"doc://HeadwireMacHost/documentation/HeadwireMacHost/PairedDevice":{"role":"symbol","abstract":[{"text":"One device paired with this helper.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PairedDevice"}],"kind":"symbol","title":"PairedDevice","navigatorTitle":[{"text":"PairedDevice","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/PairedDevice","url":"\/documentation\/headwiremachost\/paireddevice"},"doc://HeadwireMacHost/documentation/HeadwireMacHost/HostCoordinator":{"fragments":[{