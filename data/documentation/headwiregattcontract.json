nk with no code."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PairingOffer"}],"url":"\/documentation\/headwiregattcontract\/pairingoffer","navigatorTitle":[{"text":"PairingOffer","kind":"identifier"}],"identifier":"doc:\/\/HeadwireGATTContract\/documentation\/HeadwireGATTContract\/PairingOffer","type":"topic","kind":"symbol","title":"PairingOffer","role":"symbol"}}}