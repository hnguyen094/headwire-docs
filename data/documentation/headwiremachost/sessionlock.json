when "},{"code":"kCGSSessionOnConsoleKey","type":"codeVoice"},{"type":"text","text":" is 1"},{"type":"text","text":" "},{"type":"text","text":"(this user’s session is the one on the console, not another user’s under fast user switching)"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"CGSSessionScreenIsLocked","type":"codeVoice"},{"type":"text","text":" is absent or false; no dictionary counts as locked. That lock key"},{"type":"text","text":" "},{"type":"text","text":"is undocumented, and a rename would read as unlocked, so the distributed notifications"},{"type":"text","text":" "},{"code":"com.apple.screenIsLocked","type":"codeVoice"},{"type":"text","text":" and "},{"code":"com.apple.screenIsUnlocked","type":"codeVoice"},{"type":"text","text":" are a second witness: either one"},{"type":"text","text":" "},{"type":"text","text":"saying locked wins."}]}],"kind":"content"}],"references":{"doc://HeadwireMacHost/documentation/HeadwireMacHost":{"role":"collection","type":"topic","abstract":[{"type":"text","text":"Headwire Helper’s streaming, input and pairing: the code that serves paired devices from the Mac."}],"title":"HeadwireMacHost","kind":"symbol","url":"\/documentation\/headwiremachost","identifier":"doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost"},"doc://HeadwireMacHost/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/HeadwireMacHost\/s8SendableP","type":"unresolvable"},"doc://HeadwireMacHost/documentation/HeadwireMacHost/SessionLock":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SessionLock","kind":"identifier"}],"navigatorTitle":[{"text":"SessionLock","kind":"identifier"}],"url":"\/documentation\/headwiremachost\/sessionlock","title":"SessionLock","identifier":"doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/SessionLock","role":"symbol","abstract":[{"type":"text","text":"Whether this Mac’s user is at an unlocked console: a locked Mac pairs nothing over the cable,"},{"type":"text","text":" "},{"type":"text","text":"since nobody could answer the question it would put."}],"kind":"symbol","type":"topic"},"doc://HeadwireMacHost/documentation/HeadwireMacHost/SessionLock/isOnConsole()":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isOnConsole","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"url":"\/documentation\/headwiremachost\/sessionlock\/isonconsole()","title":"isOnConsole()","identifier":"doc:\/\/HeadwireMacHost\/documentation\/HeadwireMacHost\/SessionLock\/isOnConsole()","role":"symbol","abstract":[{"type":"text","text":"Whether this user’s session has the Mac’s screen now, locked or not: false only while the"},{"type":"text","text":" "},{"type":"text","text":"session dictionary says another user’s session, or the login window, is in front under fast"},{"type":"text","text":" "},{"type":"text","text":"user switching. Unlike "},{"type":"codeVoice","code":"unlocked()"},{"type":"text","text":", a missing dictionary or key reads as in front, since"},{"type":"text","text":" "},{"type":"text","text":"the host follows this and must not stay off on a Mac that stops reporting it."}],"kind":"symbol","type":"topic"}}}