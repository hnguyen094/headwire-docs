{"hierarchy":{"paths":[["doc:\/\/HeadwireCoding\/documentation\/HeadwireCoding"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnknownFields","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A later build adds fields to a record; this build, installed over it, reads the record without"},{"type":"text","text":" "},{"type":"text","text":"them and, with a synthesised encoder, writes it back without them, so the later build loses"},{"type":"text","text":" "},{"type":"text","text":"what it stored when it comes back. A record that holds an "},{"type":"codeVoice","code":"UnknownFields"},{"type":"text","text":" reads them with"},{"type":"text","text":" "},{"type":"codeVoice","code":"init(from:besides:)"},{"type":"text","text":" in its decoder and writes them with "},{"type":"reference","identifier":"doc:\/\/HeadwireCoding\/documentation\/HeadwireCoding\/UnknownFields\/encode(to:)","isActive":true},{"type":"text","text":" in its encoder,"},{"type":"text","text":" "},{"type":"text","text":"beside its own."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It works record by record, never on a whole file: a record this build removes goes with its"},{"type":"text","text":" "},{"type":"text","text":"unknown fields, and a field this build knows is never kept here, so an optional it clears stays"},{"type":"text","text":" "},{"type":"text","text":"cleared. A key this build reads only to migrate from goes in the known keys too, so it isn’t"},{"type":"text","text":" "},{"type":"text","text":"written back."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two values always compare equal and hash alike: to this build, two records that differ only"},{"type":"text","text":" "},{"type":"text","text":"in what a later build added are the same record."}]}],"kind":"content"}],"topicSections":[{"title":"Operators","anchor":"Operators","identifiers":["doc:\/\/HeadwireCoding\/documentation\/HeadwireCoding\/UnknownFields\/==(_:_:)"],"generated":true},{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/HeadwireCoding\/documentation\/HeadwireCoding\/UnknownFields\/init()","doc:\/\/HeadwireCoding\/documentation\/HeadwireCoding\/UnknownFields\/init(from:besides:)-34arw","doc:\/\/HeadwireCoding\/documentation\/HeadwireCoding\/UnknownFields\/init(from:besides:)-9svew"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/HeadwireCoding\/documentation\/HeadwireCoding\/UnknownFields\/isEmpty"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/HeadwireCoding\/documentation\/HeadwireCoding\/UnknownFields\/encode(to:)","doc:\/\/HeadwireCoding\/documentation\/HeadwireCoding\/UnknownFields\/hash(into:)"],"generated":true}],"sections":[],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"UnknownFields"}],"roleHeading":"Structure","externalID":"s:14HeadwireCoding13UnknownFieldsV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnknownFields","kind":"identifier"}],"role":"symbol","symbolKind":"struct","modules":[{"name":"HeadwireCoding"}],"title":"UnknownFields"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HeadwireCoding\/documentation\/HeadwireCoding\/UnknownFields"},"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/HeadwireCoding\/SQ","doc:\/\/HeadwireCoding\/SH","doc:\/\/HeadwireCoding\/s8SendableP","doc:\/\/HeadwireCoding\/s16SendableMetatypeP"],"kind":"relationships"}],"abstract":[{"type":"text","text":"The fields of a stored record that this build doesn’t know, kept so the next write puts them back."}],"var