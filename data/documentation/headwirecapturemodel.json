{"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/HeadwireCaptureModel\/documentation\/HeadwireCaptureModel","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"HeadwireCaptureModel holds everything about capture that can be decided without a capture card."},{"type":"text","text":" "},{"type":"text","text":"It describes devices and the formats they offer, picks the format to run when the person has not"},{"type":"text","text":" "},{"type":"text","text":"chosen one, finds the Mac’s picture inside a padded frame, judges whether frames carry the range"},{"type":"text","text":" "},{"type":"text","text":"their pixel format claims, keeps the per-card profile the app stores, and turns the frames recorded"},{"type":"text","text":" "},{"type":"text","text":"during a calibration into a result. Everything here is plain value code that builds for iOS and"},{"type":"text","text":" "},{"type":"text","text":"macOS and is tested against fixtures shaped like real cards’ format lists. It does not open a"},{"type":"text","text":" "},{"type":"text","text":"device, run a capture session, or draw a frame: that is "},{"code":"HeadwireCapture","type":"codeVoice"},{"type":"text","text":", which re-exports this"},{"type":"text","text":" "},{"type":"text","text":"module, so code that imports "},{"code":"HeadwireCapture","type":"codeVoice"},{"type":"text","text":" sees these types too."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/headwirecapturemodel"]}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"The value types and pure decisions behind capture: devices, formats, format selection, content bounds, card profiles, and calibration analysis."}],"metadata":{"roleHeading":"Framework","symbolKind":"module","role":"collection",