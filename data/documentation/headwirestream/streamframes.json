{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"StreamFrames","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every link that carries video hands its decoded frames here, and only the shown link’s reach"},{"type":"text","text":" "},{"type":"text","text":"the sink, on the decoder’s thread, with nothing between. Each link’s newest frame is kept, so"},{"type":"text","text":" "},{"type":"text","text":"showing a link that already has one (an Instant switch backup) draws that frame at once rather"},{"type":"text","text":" "},{"type":"text","text":"than waiting for the next. Showing a link that has none leaves the last frame drawn on screen"},{"type":"text","text":" "},{"type":"text","text":"until the new link’s first frame, so a switch never shows a blank picture."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/HeadwireStream\/documentation\/HeadwireStream\/StreamFrames","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/HeadwireStream\/documentation\/HeadwireStream\/StreamAudio"],"anchor":"Video-and-sound","title":"Video and sound","generated":true}],"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/HeadwireStream\/s8SendableP","doc:\/\/HeadwireStream\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/headwirestream\/streamframes"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"identifiers":["doc:\/\/HeadwireStream\/documentation\/HeadwireStream\/StreamFrames\/init()"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/HeadwireStream\/d