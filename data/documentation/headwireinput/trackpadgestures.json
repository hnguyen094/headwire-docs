ole":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"armed","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"url":"\/documentation\/headwireinput\/trackpadgestures\/armed","type":"topic"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/otherTouch()":{"title":"otherTouch()","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/otherTouch()","abstract":[{"type":"text","text":"A touch that is not a finger (a Pencil, the iPad’s own trackpad or mouse) lands. It is never"},{"type":"text","text":" "},{"type":"text","text":"part of a stroke, but with no finger down it starts something new: the last stroke’s silence"},{"type":"text","text":" "},{"type":"text","text":"ends, so a Pencil on the portrait trackpad right after a gesture is not ignored."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"otherTouch","kind":"identifier"},{"text":"()","kind":"text"}],"url":"\/documentation\/headwireinput\/trackpadgestures\/othertouch()","type":"topic","role":"symbol"},"doc://HeadwireInput/documentation/HeadwireInput":{"title":"HeadwireInput","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput","abstract":[{"type":"text","text":"Input events from the iPad, the same whichever path carries them to the Mac."}],"kind":"symbol","url":"\/documentation\/headwireinput","type":"topic","role":"collection"},"doc://HeadwireInput/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/HeadwireInput\/s8SendableP","type":"unresolvable"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/down(_:at:time:holding:)":{"role":"symbol","title":"down(_:at:time:holding:)","kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"down"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:Si","text"