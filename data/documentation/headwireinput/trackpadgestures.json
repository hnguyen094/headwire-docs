g.","type":"text"}],"kind":"symbol","url":"\/documentation\/headwireinput\/trackpadgestures\/silent","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/silent","title":"silent","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"silent","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"role":"symbol","type":"topic"},"doc://HeadwireInput/s8SendableP":{"identifier":"doc:\/\/HeadwireInput\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/Gesture":{"abstract":[{"text":"The gestures, named as kind 28 names them (TrackpadGesture). Natural direction: fingers","type":"text"},{"text":" ","type":"text"},{"text":"moving left are ","type":"text"},{"type":"codeVoice","code":"swipeLeft"},{"text":", which brings the Space on the right.","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Gesture"}],"url":"\/documentation\/headwireinput\/trackpadgestures\/gesture","title":"TrackpadGestures.Gesture","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Gesture"}],"role":"symbol","type":"topic","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/Gesture"},"doc://HeadwireInput/s16SendableMetatypeP":{"identifier":"doc:\/\/HeadwireInput\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/Output":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/Output","url":"\/documentation\/headwireinput\/trackpadgestures\/output","title":"TrackpadGestures.Output","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Output"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text"