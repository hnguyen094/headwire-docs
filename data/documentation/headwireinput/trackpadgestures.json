riggers each system action on one Mac."}],"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/GestureShortcuts"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/Gesture":{"type":"topic","role":"symbol","abstract":[{"text":"The gestures, named as kind 28 names them (TrackpadGesture). Natural direction: fingers","type":"text"},{"text":" ","type":"text"},{"text":"moving left are ","type":"text"},{"type":"codeVoice","code":"swipeLeft"},{"text":", which brings the Space on the right.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Gesture"}],"title":"TrackpadGestures.Gesture","url":"\/documentation\/headwireinput\/trackpadgestures\/gesture","navigatorTitle":[{"kind":"identifier","text":"Gesture"}],"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/Gesture","kind":"symbol"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/cancelled(_:)":{"abstract":[{"text":"The system took a touch (an iPadOS gesture, an alert): nothing is decided for this stroke,","type":"text"},{"text":" ","type":"text"},{"text":"and one that has not armed never will; a silent one stays silent.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancelled"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"url":"\/documentation\/headwireinput\/trackpadgestures\/cancelled(_:)","role":"symbol","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/cancelled(_:)","title":"cancelled(_:)","kind":"symbol","type":"topic"},"doc://HeadwireInput/documentation/HeadwireInput":{"type":"topic","role":"collection","title":"HeadwireInput","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput","abstract":[{"text":"Input events from the iPad, the same whichever path carries them to the Mac.","type":"text"}],"url":"\/documentation\/headwireinput","kind":"symbol"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/armed":{"type":"topic","kind":"symbol","url":"\/documentation\/headwireinput\/trackpadgestures\/armed","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"armed","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"armed","role":"symbol","abstract":[{"type":"text","text":"The stroke armed: it decides at the first lift of one of its three fingers (for the checks)."}],"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/armed"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures":{"url":"\/documentation\/headwireinput\/trackpadgestures","abstract":[{"type":"text","text":"Three- and four-finger strokes on the glass, for the Mac: which stroke is a gesture, and which"},{"type":"text","text":" "},{"type":"text","text":"gesture it is. Each input surface feeds one of these with every direct touch, through its stroke"},{"type":"text","text":" "},{"type":"text","text":"observer. The counts below say three; with "},{"code":"chordFingers","type":"codeVoice"},{"type":"text","text":" 4 read four."}],"title":"TrackpadGestures","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrackpadGestures"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures","navigatorTitle":[{"kind":"identifier","text":"TrackpadGestures"}]},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/up(_:at:time:)":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"up"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"at"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CGPoint","preciseIdentifier":"c:@S@CGPoint"},{"kind":"text","text":", "},{"kind":"externalParam","text":"time"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"TimeInterval","preciseIdentifier":"c:@T@NSTimeInterval"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Output","preciseIdentifier":"s:13HeadwireInput16TrackpadGesturesV6OutputO"}],"title":"up(_:at:time:)","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/up(_:at:time:)","abstract":[{"type":"text","text":"A finger lifts. The first lift of one of the three that armed the stroke decides: "},{"type":"codeVoice","code":".gesture"},{"type":"text","text":" at"},{"type":"text","text":" "},{"type":"text","text":"most once a stroke. Any other finger lifting only leaves the stroke (where it lifted counts, if"},{"type":"text","text":" "},{"type":"text","text":"it moved)."}],"url":"\/documentation\/headwireinput\/trackpadgestures\/up(_:at:time:)","kind":"symbol"},"doc://HeadwireInput/documentation/HeadwireInput/PinchStepper":{"abstract":[{"type":"text","text":"Turns a pinch’s continuous scale into zoom steps, one per 25% of scale."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PinchStepper"}],"url":"\/documentation\/headwireinput\/pinchstepper","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PinchStepper"}],"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/PinchStepper","title":"PinchStepper","kind":"symbol","type":"topic"},"doc://HeadwireInput/documentation/HeadwireInput/SystemGestureResolver":{"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SystemGestureResolver"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemGestureResolver"}],"title":"SystemGestureResolver","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/SystemGestureResolver","abstract":[{"text":"Which system action a decided trackpad gesture asks for, remembering the view the last one opened.","type":"text"}],"url":"\/documentation\/headwireinput\/systemgestureresolver","kind":"symbol"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/init(chordFingers:)":{"kind":"symbol","role":"symbol","abstract":[{"text":"Creates a recogniser whose strokes go silent and arm at ","type":"text"},{"code":"chordFingers","type":"codeVoice"},{"text":" fingers, 3 or 4.","type":"text"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"chordFingers"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"title":"init(chordFingers:)","url":"\/documentation\/headwireinput\/trackpadgestures\/init(chordfingers:)","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/init(chordFingers:)","type":"topic"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/otherTouch()":{"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/otherTouch()","title":"otherTouch()","url":"\/documentation\/headwireinput\/trackpadgestures\/othertouch()","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"otherTouch"},{"text":"()","kind":"text"}],"role":"symbol","abstract":[{"type":"text","text":"A touch that is not a finger (a Pencil, the iPad’s own trackpad or mouse) lands. It is never"},{"type":"text","text":" "},{"type":"text","text":"part of a stroke, but with no finger down it starts something new: the last stroke’s silence"},{"type":"text","text":" "},{"type":"text","text":"ends, so a Pencil on the portrait trackpad right after a gesture is not ignored."}]},"doc://HeadwireInput/documentation/HeadwireInput/ZoomStep":{"url":"\/documentation\/headwireinput\/zoomstep","abstract":[{"type":"text","text":"One step of zoom in the frontmost app."}],"title":"ZoomStep","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ZoomStep"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/ZoomStep","navigatorTitle":[{"kind":"identifier","text":"ZoomStep"}]},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/silent":{"kind":"symbol","title":"silent","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/silent","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"silent"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"url":"\/documentation\/headwireinput\/trackpadgestures\/silent","abstract":[{"type":"text","text":"From three fingers down (see above) until the next stroke’s first touch: the surfaces send"},{"type":"text","text":" "},{"type":"text","text":"nothing."}],"type":"topic"},"doc://HeadwireInput/documentation/HeadwireInput/SystemGesture":{"kind":"symbol","title":"SystemGesture","navigatorTitle":[{"kind":"identifier","text":"SystemGesture"}],"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/SystemGesture","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemGesture"}],"url":"\/documentation\/headwireinput\/systemgesture","type":"topic","abstract":[{"text":"A Mac system action that a trackpad gesture or a key row control triggers.","type":"text"}]},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/moved(_:to:time:)":{"abstract":[{"text":"A finger moves.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"moved"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@S@CGPoint","text":"CGPoint"},{"kind":"text","text":", "},{"kind":"externalParam","text":"time"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":")"}],"url":"\/documentation\/headwireinput\/trackpadgestures\/moved(_:to:time:)","role":"symbol","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/moved(_:to:time:)","title":"moved(_:to:time:)","kind":"symbol","type":"topic"}}}