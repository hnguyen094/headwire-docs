:"swift","url":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures"},"abstract":[{"type":"text","text":"Three- and four-finger strokes on the glass, for the Mac: which stroke is a gesture, and which"},{"type":"text","text":" "},{"type":"text","text":"gesture it is. Each input surface feeds one of these with every direct touch, through its stroke"},{"type":"text","text":" "},{"type":"text","text":"observer. The counts below say three; with "},{"code":"chordFingers","type":"codeVoice"},{"type":"text","text":" 4 read four."}],"references":{"doc://HeadwireInput/documentation/HeadwireInput/GestureShortcuts":{"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"GestureShortcuts"}],"type":"topic","url":"\/documentation\/headwireinput\/gestureshortcuts","title":"GestureShortcuts","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GestureShortcuts"}],"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/GestureShortcuts","abstract":[{"text":"The keystroke that triggers each system action on one Mac.","type":"text"}]},"doc://HeadwireInput/documentation/HeadwireInput":{"role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/headwireinput","title":"HeadwireInput","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput","abstract":[{"text":"Input events from the iPad, the same whichever path carries them to the Mac.","type":"text"}]},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/silent":{"kind":"symbol","title":"silent","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/silent","type":"topic","role":"symbol","url":"\/documentation\/headwireinput\/trackpadgestures\/silent","abstract":[{"type":"text","text":"From three fingers down (see above) until the next stroke’s first touch: the surfaces send"},{"type":"text","text":" "},{"type":"text","text":"nothing."}],"fragments":[{"text":"var","ki