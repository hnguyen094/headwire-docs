."}],"kind":"symbol","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/down(_:at:time:holding:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"down","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"at"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CGPoint","preciseIdentifier":"c:@S@CGPoint"},{"kind":"text","text":", "},{"kind":"externalParam","text":"time"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"TimeInterval","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":", ","kind":"text"},{"text":"holding","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Output","preciseIdentifier":"s:13HeadwireInput16TrackpadGesturesV6OutputO","kind":"typeIdentifier"}],"title":"down(_:at:time:holding:)","url":"\/documentation\/headwireinput\/trackpadgestures\/down(_:at:time:holding:)"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/moved(_:to:time:)":{"type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A finger moves."}],"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/moved(_:to:time:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"moved"},{"kind":"text","text":"("},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"kind":"text","text":": "},{"text":"CGPoint","kind":"typeIdentifier","preciseIdentifier":"c:@S@CGPoint"},{"text":", ","kind":"text"},{"text":"time","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":")","kind":"text"}],"title"