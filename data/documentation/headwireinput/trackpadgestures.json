\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/down(_:at:time:holding:)","title":"down(_:at:time:holding:)","abstract":[{"text":"A finger lands. ","type":"text"},{"code":"holding","type":"codeVoice"},{"text":": a button the surface pressed is held (the trackpad’s drag).","type":"text"},{"text":" ","type":"text"},{"text":"Returns ","type":"text"},{"code":".silenced","type":"codeVoice"},{"text":" once, when this finger makes the stroke silent.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/headwireinput\/trackpadgestures\/down(_:at:time:holding:)"},"doc://HeadwireInput/documentation/HeadwireInput":{"abstract":[{"text":"Input events from the iPad, the same whichever path carries them to the Mac.","type":"text"}],"kind":"symbol","url":"\/documentation\/headwireinput","title":"HeadwireInput","type":"topic","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput","role":"collection"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/up(_:at:time:)":{"kind":"symbol","url":"\/documentation\/headwireinput\/trackpadgestures\/up(_:at:time:)","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/up(_:at:time:)","title":"up(_:at:time:)","abstract":[{"text":"A finger lifts. The first lift of one of the three that armed the stroke decides: ","type":"text"},{"code":".gesture","type":"codeVoice"},{"text":" at","type":"text"},{"text":" ","type":"text"},{"text":"most once a stroke. Any other finger lifting only leaves the stroke (where it lifted counts, if","type":"text"},{"text":" ","type":"text"},{"text":"it moved).","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"up"},{"kind":"text","text":"("},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"at"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@S@CGPoint","kind":"typ