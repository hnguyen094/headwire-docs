tures"}],"role":"symbol","abstract":[{"type":"text","text":"Three- and four-finger strokes on the glass, for the Mac: which stroke is a gesture, and which"},{"type":"text","text":" "},{"type":"text","text":"gesture it is. Each input surface feeds one of these with every direct touch, through its stroke"},{"type":"text","text":" "},{"type":"text","text":"observer. The counts below say three; with "},{"type":"codeVoice","code":"chordFingers"},{"type":"text","text":" 4 read four."}],"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures","title":"TrackpadGestures","url":"\/documentation\/headwireinput\/trackpadgestures"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/Gesture":{"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Gesture"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Gesture"}],"role":"symbol","abstract":[{"type":"text","text":"The gestures, named as kind 28 names them (TrackpadGesture). Natural direction: fingers"},{"type":"text","text":" "},{"type":"text","text":"moving left are "},{"type":"codeVoice","code":"swipeLeft"},{"type":"text","text":", which brings the Space on the right."}],"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/Gesture","title":"TrackpadGestures.Gesture","url":"\/documentation\/headwireinput\/trackpadgestures\/gesture"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/silent":{"role":"symbol","url":"\/documentation\/headwireinput\/trackpadgestures\/silent","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/silent","title":"silent","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"silent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"From three fingers down (see above) until the next stroke’s first touch: the surfaces send"},{"type":"text","text":" "},{"type":"text","text":"nothing."}]},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/otherTouch()":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A touch that is not a finger (a Pencil, the iPad’s own trackpad or mouse) lands. It is never"},{"type":"text","text":" "},{"type":"text","text":"part of a stroke, but with no finger down it starts something new: the last stroke’s silence"},{"type":"text","text":" "},{"type":"text","text":"ends, so a Pencil on the portrait trackpad right after a gesture is not ignored."}],"kind":"symbol","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/otherTouch()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"otherTouch","kind":"identifier"},{"text":"()","kind":"text"}],"title":"otherTouch()","url":"\/documentation\/headwireinput\/trackpadgestures\/othertouch()"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/armed":{"type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"armed","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"role":"symbol","abstract":[{"type":"text","text":"The stroke armed: it decides at the first lift of one of its three fingers (for the checks)."}],"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/armed","title":"armed","url":"\/documentation\/headwireinput\/trackpadgestures\/armed"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/up(_:at:time:)":{"role":"symbol","url":"\/documentation\/headwireinput\/trackpadgestures\/up(_:at:time:)","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/up(_:at:time:)","title":"up(_:at:time:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","