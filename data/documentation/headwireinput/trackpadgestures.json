r":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/chordFingers","abstract":[{"text":"The fingers that silence and arm a stroke.","type":"text"}]},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/init(chordFingers:)":{"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/init(chordFingers:)","title":"init(chordFingers:)","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Creates a recogniser whose strokes go silent and arm at "},{"type":"codeVoice","code":"chordFingers"},{"type":"text","text":" fingers, 3 or 4."}],"kind":"symbol","url":"\/documentation\/headwireinput\/trackpadgestures\/init(chordfingers:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"chordFingers","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/up(_:at:time:)":{"kind":"symbol","title":"up(_:at:time:)","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/up(_:at:time:)","type":"topic","role":"symbol","url":"\/documentation\/headwireinput\/trackpadgestures\/up(_:at:time:)","abstract":[{"type":"text","text":"A finger lifts. The first lift of one of the three that armed the stroke decides: "},{"type":"codeVoice","code":".gesture"},{"type":"text","text":" at"},{"type":"text","text":" "},{"type":"text","text":"most once a stroke. Any other finger lifting only leaves the stroke (where it lifted counts, if"},{"type":"text","text":" "},{"type":"text","text":"it moved)."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"up","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"CGPoint","preciseIdentifier":"c:@S@CGPoint","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"time","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","preciseIdentifier":"c:@T@NSTimeInterval","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Output","preciseIdentifier":"s:13HeadwireInput16TrackpadGesturesV6OutputO","kind":"typeIdentifier"}]},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/cancelled(_:)":{"kind":"symbol","title":"cancelled(_:)","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/cancelled(_:)","type":"topic","role":"symbol","url":"\/documentation\/headwireinput\/trackpadgestures\/cancelled(_:)","abstract":[{"type":"text","text":"The system took a touch (an iPadOS gesture, an alert): nothing is decided for this stroke,"},{"type":"text","text":" "},{"type":"text","text":"and one that has not armed never will; a silent one stays silent."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancelled","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://HeadwireInput/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/HeadwireInput\/s8SendableP"},"doc://HeadwireInput/documentation/HeadwireInput/PinchStepper":{"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PinchStepper"}],"type":"topic","url":"\/documentation\/headwireinput\/pinchstepper","title":"PinchStepper","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PinchStepper"}],"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/PinchStepper","abstract":[{"text":"Turns a pinch’s continuous scale into zoom steps, one per 25% of scale.","type":"text"}]},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures":{"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TrackpadGestures"}],"url":"\/documentation\/headwireinput\/trackpadgestures","type":"topic","title":"TrackpadGestures","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrackpadGestures"}],"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures","abstract":[{"type":"text","text":"Three- and four-finger strokes on the glass, for the Mac: which stroke is a gesture, and which"},{"type":"text","text":" "},{"type":"text","text":"gesture it is. Each input surface feeds one of these with every direct touch, through its stroke"},{"type":"text","text":" "},{"type":"text","text":"observer. The counts below say three; with "},{"type":"codeVoice","code":"chordFingers"},{"type":"text","text":" 4 read four."}]},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/moved(_:to:time:)":{"kind":"symbol","title":"moved(_:to:time:)","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/moved(_:to:time:)","type":"topic","role":"symbol","url":"\/documentation\/headwireinput\/trackpadgestures\/moved(_:to:time:)","abstract":[{"type":"text","text":"A finger moves."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"moved","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"CGPoint","preciseIdentifier":"c:@S@CGPoint","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"time","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","preciseIdentifier":"c:@T@NSTimeInterval","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/otherTouch()":{"abstract":[{"type":"text","text":"A touch that is not a finger (a Pencil, the iPad’s own trackpad or mouse) lands. It is never"},{"type":"text","text":" "},{"type":"text","text":"part of a stroke, but with no finger down it starts something new: the last stroke’s silence"},{"type":"text","text":" "},{"type":"text","text":"ends, so a Pencil on the portrait trackpad right after a gesture is not ignored."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"otherTouch","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/headwireinput\/trackpadgestures\/othertouch()","title":"otherTouch()","kind":"symbol","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/otherTouch()"}}}