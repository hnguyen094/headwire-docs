c:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures","navigatorTitle":[{"kind":"identifier","text":"TrackpadGestures"}],"type":"topic"},"doc://HeadwireInput/documentation/HeadwireInput/ZoomStep":{"url":"\/documentation\/headwireinput\/zoomstep","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ZoomStep","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"One step of zoom in the frontmost app.","type":"text"}],"title":"ZoomStep","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/ZoomStep","type":"topic","navigatorTitle":[{"text":"ZoomStep","kind":"identifier"}]},"doc://HeadwireInput/documentation/HeadwireInput/SystemGestureResolver":{"abstract":[{"text":"Which system action a decided trackpad gesture asks for, remembering the view the last one opened.","type":"text"}],"url":"\/documentation\/headwireinput\/systemgestureresolver","kind":"symbol","title":"SystemGestureResolver","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemGestureResolver"}],"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/SystemGestureResolver","navigatorTitle":[{"kind":"identifier","text":"SystemGestureResolver"}],"role":"symbol"},"doc://HeadwireInput/documentation/HeadwireInput/PinchStepper":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PinchStepper","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Turns a pinch’s continuous scale into zoom steps, one per 25% of scale."}],"url":"\/documentation\/headwireinput\/pinchstepper","role":"symbol","title":"PinchStepper","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/PinchStepper","navigatorTitle":[{"text":"PinchStepper","kind":"identifier"}],"type":"topic"},"doc://HeadwireInput/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/HeadwireInput\/s16S