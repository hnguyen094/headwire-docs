stures":{"title":"TrackpadGestures","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TrackpadGestures"}],"abstract":[{"text":"Three- and four-finger strokes on the glass, for the Mac: which stroke is a gesture, and which","type":"text"},{"text":" ","type":"text"},{"text":"gesture it is. Each input surface feeds one of these with every direct touch, through its stroke","type":"text"},{"type":"text","text":" "},{"text":"observer. The counts below say three; with ","type":"text"},{"type":"codeVoice","code":"chordFingers"},{"text":" 4 read four.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures","navigatorTitle":[{"kind":"identifier","text":"TrackpadGestures"}],"role":"symbol","url":"\/documentation\/headwireinput\/trackpadgestures"},"doc://HeadwireInput/documentation/HeadwireInput/TrackpadGestures/otherTouch()":{"url":"\/documentation\/headwireinput\/trackpadgestures\/othertouch()","type":"topic","abstract":[{"text":"A touch that is not a finger (a Pencil, the iPad’s own trackpad or mouse) lands. It is never","type":"text"},{"type":"text","text":" "},{"type":"text","text":"part of a stroke, but with no finger down it starts something new: the last stroke’s silence"},{"type":"text","text":" "},{"type":"text","text":"ends, so a Pencil on the portrait trackpad right after a gesture is not ignored."}],"identifier":"doc:\/\/HeadwireInput\/documentation\/HeadwireInput\/TrackpadGestures\/otherTouch()","title":"otherTouch()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"otherTouch"},{"kind":"text","text":"()"}],"role":"symbol"}}}