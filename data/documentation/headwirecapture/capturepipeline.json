peIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:20HeadwireCaptureModel19CalibrationGeometryV4CropV","text":"Crop","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"duration","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:20HeadwireCaptureModel20CalibrationRecordingV","text":"CalibrationRecording","kind":"typeIdentifier"}],"role":"symbol","deprecated":true},"doc://headwirecapture.HeadwireCapture/documentation/HeadwireCapture/CaptureClient/formats":{"deprecated":true,"identifier":"doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CaptureClient\/formats","url":"\/documentation\/headwirecapture\/captureclient\/formats","type":"topic","abstract":[{"text":"The formats a connected device offers, in the order the device lists them.","type":"text"}],"title":"formats","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"formats"},{"kind":"text","text":": "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"device"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20HeadwireCaptureModel0B6DeviceV","text":"CaptureDevice"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:20HeadwireCaptureModel0B6DeviceV2IDa","text":"ID"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:20HeadwireCaptureModel0B6FormatV","text":"CaptureFormat"},{"kind":"text","text":"]"}],"kind":"symbol"},"doc://headwirecapture.HeadwireCapture/documentation/HeadwireCapture/CapturePreviewView":{"url":"\/documentation\/headwirecapture\/capturepreviewview","abstract":[{"type":"text","text":"Shows the capture stream at a scaling and reports where the video and its content land."}],"type":"topic","role":"symbol","identifier":"doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CapturePreviewView","kind":"symbol","navigatorTitle":[{"text":"CapturePreviewView","kind":"identifier"}],"title":"CapturePreviewView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CapturePreviewView","kind":"identifier"}]},"doc://headwirecapture.HeadwireCapture/documentation/HeadwireCapture/CaptureClient/devices":{"identifier":"doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CaptureClient\/devices","url":"\/documentation\/headwirecapture\/captureclient\/devices","type":"topic","abstract":[{"text":"The connected external devices, emitted now and again on every plug or unplug.","type":"text"}],"title":"devices","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"devices"},{"kind":"text","text":": "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<["},{"kind":"typeIdentifier","text":"CaptureDevice","preciseIdentifier":"s:20HeadwireCaptureModel0B6DeviceV"},{"kind":"text","text":"]>"}],"kind":"symbol"},"doc://headwirecapture.HeadwireCapture/documentation/HeadwireCapture/CaptureClient":{"url":"\/documentation\/headwirecapture\/captureclient","kind":"symbol","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Discovers external capture devices and streams one of them to a "},{"identifier":"doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CapturePreviewView","type":"reference","isActive":true},{"type":"text","text":"."}],"title":"CaptureClient","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CaptureClient","kind":"identifier"}],"navigatorTitle":[{"text":"CaptureClient","kind":"identifier"}],"identifier":"doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CaptureClient"}}}