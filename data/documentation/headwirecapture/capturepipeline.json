"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:20HeadwireCaptureModel20CalibrationRecordingV","text":"CalibrationRecording","kind":"typeIdentifier"}],"kind":"symbol","role":"symbol","type":"topic","deprecated":true,"url":"\/documentation\/headwirecapture\/captureclient\/recordcalibration","identifier":"doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CaptureClient\/recordCalibration","title":"recordCalibration"},"doc://headwirecapture.HeadwireCapture/documentation/HeadwireCapture/CaptureClient/devices":{"abstract":[{"type":"text","text":"The connected external devices, emitted now and again on every plug or unplug."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"devices","kind":"identifier"},{"text":": ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<[","kind":"text"},{"preciseIdentifier":"s:20HeadwireCaptureModel0B6DeviceV","text":"CaptureDevice","kind":"typeIdentifier"},{"text":"]>","kind":"text"}],"kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/headwirecapture\/captureclient\/devices","identifier":"doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CaptureClient\/devices","title":"devices"},"doc://headwirecapture.HeadwireCapture/documentation/HeadwireCapture/CaptureClient/deliveredFrameRate":{"abstract":[{"type":"text","text":"The rate frames arrived at over the last second, emitted now and each second while frames flow."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deliveredFrameRate","kind":"identifier"},{"text":": ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"preciseIdentifier":"s:ScS","text":"AsyncStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":"?>","kind":"text"}],"kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/headwirecapture\/captureclient\/deliveredframerate","identifier":"doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CaptureClient\/deliveredFrameRate","title":"deliveredFrameRate"}}}