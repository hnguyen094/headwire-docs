{"hierarchy":{"paths":[["doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture"]]},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Frames the app hands in from outside a capture session, such as a decoded network stream, for a","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CapturePreviewView"},{"type":"text","text":" to draw as it draws a capture card."}],"identifier":{"url":"doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/FrameFeed","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Class","symbolKind":"class","role":"symbol","externalID":"s:15HeadwireCapture9FrameFeedC","modules":[{"name":"HeadwireCapture"}],"navigatorTitle":[{"text":"FrameFeed","kind":"identifier"}],"title":"FrameFeed","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FrameFeed"}]},"kind":"symbol","topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/FrameFeed\/init()"],"anchor":"Initializers"},{"anchor":"Instance-Properties","identifiers":["doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/FrameFeed\/mirror","doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/FrameFeed\/tap"],"generated":true,"title":"Instance Properties"},{"anchor":"Instance-Methods","identifiers":["doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/FrameFeed\/send(_:)"],"generated":true,"title":"Instance Methods"}],"seeAlsoSections":[{"title":"Showing the stream","generated":true,"identifiers":["doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CapturePreviewView","doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CapturePreviewUIView","doc:\/\/headwirecapture.HeadwireCaptur