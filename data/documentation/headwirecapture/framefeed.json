{"abstract":[{"text":"Frames the app hands in from outside a capture session, such as a decoded network stream, for a","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CapturePreviewView"},{"text":" to draw as it draws a capture card.","type":"text"}],"kind":"symbol","topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/FrameFeed\/init()"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/FrameFeed\/send(_:)"]}],"hierarchy":{"paths":[["doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/FrameFeed"},"seeAlsoSections":[{"title":"Showing the stream","anchor":"Showing-the-stream","generated":true,"identifiers":["doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CapturePreviewView","doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CapturePreviewUIView","doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CapturePreviewSource"]}],"variants":[{"paths":["\/documentation\/headwirecapture\/framefeed"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FrameFeed","kind":"identifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"mentions":["doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CapturePipeline"],"kind":"mentions"},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Its frames take the Metal path whatever the upscaling setting, so fit, fill, zoom, the reported"},{"type":"text","text":" "},{"type":"text","text":"layout, and MetalFX all apply; with upscaling off they are drawn in one bilinear pass. The"},{"type":"text","text":" "},{"type":"text","text":"displayed size is the newest frame’s, and the content is always the whole frame, since a stream"},{"type":"text","text":" "},{"type":"text","text":"has no padding. Each sample must carry a "},{"type":"codeVoice","code":"CVPixelBuffer"},{"type":"text","text":" in a layout the front end reads, such"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"420v"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Frames are drawn on the feed’s own queue, newest first: a frame that arrives while another is"},{"type":"text","text":" "},{"type":"text","text":"still waiting replaces it. The newest frame is kept, so the picture stays on screen until the"},{"type":"text","text":" "},{"type":"text","text":"next one, and is drawn again after a relayout or when a new view attaches."}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"FrameFeed","role":"symbol","externalID":"s:15HeadwireCapture9FrameFeedC","navigatorTitle":[{"text":"FrameFeed","kind":"identifier"}],"modules":[{"name":"HeadwireCapture"}],"symbolKind":"class","roleHeading":"Class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FrameFeed","kind":"identifier"}]},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/headwirecapture.HeadwireCapture\/s8SendableP","doc:\/\/headwirecapture.HeadwireCapture\/s16SendableMetatypeP"]}],"references":{"doc://headwirecapture.HeadwireCapture/documentation/HeadwireCapture/FrameFeed/send(_:)":{"title":"se