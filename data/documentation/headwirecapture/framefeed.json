{"abstract":[{"text":"Frames the app hands in from outside a capture session, such as a decoded network stream, for a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CapturePreviewView","isActive":true,"type":"reference"},{"text":" to draw as it draws a capture card.","type":"text"}],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/FrameFeed\/init()"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/FrameFeed\/send(_:)"]}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/headwirecapture.HeadwireCapture\/s8SendableP","doc:\/\/headwirecapture.HeadwireCapture\/s16SendableMetatypeP"],"kind":"relationships"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/FrameFeed"},"variants":[{"paths":["\/documentation\/headwirecapture\/framefeed"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FrameFeed"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CapturePipeline"]},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"inlineContent":[{"text":"Its frames take the Metal path whatever the upscaling setting, so fit, fill, zoom, the reported","type":"text"},{"text":" ","type":"text"},{"text":"layout, and MetalFX all apply; with upscaling off they are drawn in one bilinear pass. The","type":"text"},{"type":"text","text":" "},{"text":"displayed size is the newest frame’s, and the content is always the whole frame, since a stream","type":"text"},{"text":" ","type":"text"},{"text":"has no padding. Each sample must carry a ","type":"text"},{"code":"CVPixelBuffer","type":"codeVoice"},{"text":" in a layout the front end reads, such","type":"text"},{"type":"text","text":" "},{"type":"text","text":"as "},{"code":"420v","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Frames are drawn on the feed’s own queue, newest first: a frame that arrives while another is","type":"text"},{"text":" ","type":"text"},{"text":"still waiting replaces it. The newest frame is kept, so the picture stays on screen until the","type":"text"},{"text":" ","type":"text"},{"text":"next one, and is drawn again after a relayout or when a new view attaches.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"externalID":"s:15HeadwireCapture9FrameFeedC","symbolKind":"class","title":"FrameFeed","navigatorTitle":[{"text":"FrameFeed","kind":"identifier"}],"role":"symbol","modules":[{"name":"HeadwireCapture"}],"roleHeading":"Class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FrameFeed"}]},"hierarchy":{"paths":[["doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture"]]},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Showing-the-stream","title":"Showing the stream","identifiers":["doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CapturePreviewView","doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CapturePreviewUIView","doc:\/\/headwirecapture.HeadwireCapture\/documentation\/HeadwireCapture\/CapturePreviewSource"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://headwirecapture.HeadwireCapture/documentation/HeadwireCapture/CapturePreviewView":{"abstract":